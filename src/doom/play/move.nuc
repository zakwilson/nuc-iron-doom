; Movement and its collisions, sliding along walls, aiming and shooting,
; using lines, blast damage, and things caught by a moving sector.

(ns doom.play.move)

(import-use nucleus.slice)
(import-use nucleus.vector)
(import-use nucleus.coll)
(import-use nucleus.math)
(import-use doom.error)
(import-use doom.util)
(import-use doom.fixed)
(import-use doom.rand)
(import-use doom.info)
(import-use doom.play.defs)
(import-use doom.play.map)
(import-use doom.play.world)
(import-use doom.play.maputl)
(import-use doom.play.mobj)
(import-use doom.play.inter)
(import-use doom.play.spec)
(import-use doom.play.switch)
(import-use doom.play.sight)

; Iterator callbacks return a plain bool, so an error from inside one (an
; I_Error in an action) waits here until the iteration ends.
(defn- scratch (w:&World):&MapScratch (return (ref w 'scratch)))

(defn- set-box (w:&World x:Fixed y:Fixed r:Fixed):void
  (let (b (ref (scratch w) 'tm-bbox))
    (set! (b 'top) (wrap-add y r))
    (set! (b 'bottom) (wrap-sub y r))
    (set! (b 'right) (wrap-add x r))
    (set! (b 'left) (wrap-sub x r))))

(defn- tm-thing (w:&World):&Mobj (return (unwrap ((scratch w) 'tm-thing))))

; The first error raised inside an iterator callback, raised again after.
(defn- note-error (w:&World r:(Fallible void)):bool
  (match r
    ((ok) (return true))
    ((err e) (when (none? (w 'pending-error)) (set! (w 'pending-error) (some e))) (return true))))

; A state change's result, minus whether the mobj survived it.
(defn- discard (r:(Fallible bool)):(Fallible void)
  (match r ((ok b) (return (ok))) ((err e) (return (err e)))))

(defn take-error (w:&World):(Fallible void)
  (match (w 'pending-error)
    ((some e) (set! (w 'pending-error) none) (return (err e)))
    ((none) (return (ok)))))

; PIT_StompThing: a teleporting player telefrags what it lands on.
(defn- stomp-thing (w:&World t:&Mobj):bool
  (when (= (bit-and (t 'flags) MF-SHOOTABLE) 0) (return true))
  (let (tm (tm-thing w) sc (scratch w)
        blockdist (wrap-add (t 'radius) (tm 'radius)))
    (when (or (>= (iabs (wrap-sub (t 'x) (sc 'tm-x))) blockdist)
              (>= (iabs (wrap-sub (t 'y) (sc 'tm-y))) blockdist))
      (return true))
    (when (= (unsafe/cast usize t) (unsafe/cast usize tm)) (return true))
    ; Monsters only telefrag on MAP30.
    (when (and (none? (tm 'player)) (!= ((ref w 'rules) 'map) 30)) (return false))
    (note-error w (damage-mobj w t (some tm) (some tm) 10000))
    (return true)))

(defstruct BlockRange xl:i32 xh:i32 yl:i32 yh:i32)

(defn- block-range (w:&World pad:Fixed):BlockRange
  (let (b ((scratch w) 'tm-bbox) l (ref w 'level))
    (return (BlockRange
              (bit-shr (wrap-sub (wrap-sub (b 'left) (l 'bmap-org-x)) pad) MAPBLOCKSHIFT)
              (bit-shr (wrap-add (wrap-sub (b 'right) (l 'bmap-org-x)) pad) MAPBLOCKSHIFT)
              (bit-shr (wrap-sub (wrap-sub (b 'bottom) (l 'bmap-org-y)) pad) MAPBLOCKSHIFT)
              (bit-shr (wrap-add (wrap-sub (b 'top) (l 'bmap-org-y)) pad) MAPBLOCKSHIFT)))))

(defn- start-check (w:&World m:&Mobj x:Fixed y:Fixed):void
  (let (sc (scratch w) l (ref w 'level)
        ss (sub-sector-at l (point-in-sub-sector l x y))
        sec (sector-at l (ss 'sector)))
    (set! (sc 'tm-thing) (some m))
    (set! (sc 'tm-flags) (m 'flags))
    (set! (sc 'tm-x) x)
    (set! (sc 'tm-y) y)
    (set-box w x y (m 'radius))
    (set! (sc 'ceiling-line) none)
    (set! (sc 'tm-floor-z) (sec 'floor-height))
    (set! (sc 'tm-dropoff-z) (sec 'floor-height))
    (set! (sc 'tm-ceiling-z) (sec 'ceiling-height))
    (set! (w 'valid-count) (+ (w 'valid-count) 1))
    (set! (sc 'num-spechit) 0)
    (clear! (ref sc 'spechit))))

; P_TeleportMove.
(defn teleport-move (w:&World m:&Mobj x:Fixed y:Fixed):(Fallible bool)
  (start-check w m x y)
  (let (r (block-range w MAXRADIUS) bx (r 'xl))
    (while (<= bx (r 'xh))
      (let (by (r 'yl))
        (while (<= by (r 'yh))
          (when (not (block-things-iterator w bx by stomp-thing))
            (try (take-error w))
            (return (ok false)))
          (inc! by)))
      (inc! bx)))
  (try (take-error w))
  (unset-thing-position w m)
  (let (sc (scratch w))
    (set! (m 'floor-z) (sc 'tm-floor-z))
    (set! (m 'ceiling-z) (sc 'tm-ceiling-z)))
  (set! (m 'x) x)
  (set! (m 'y) y)
  (set-thing-position w m)
  (return (ok true)))

; PIT_CheckLine: whether the move's box may cross this line, narrowing the
; floor and ceiling heights it allows.
(defn- check-line (w:&World li:usize):bool
  (let (sc (scratch w) b (ref sc 'tm-bbox) l (ref w 'level) ld (line-at l li) lb (ld 'bbox)
        tm (tm-thing w))
    (when (or (<= (b 'right) (lb 'left)) (>= (b 'left) (lb 'right))
              (<= (b 'top) (lb 'bottom)) (>= (b 'bottom) (lb 'top)))
      (return true))
    (when (!= (box-on-line-side l b ld) -1) (return true))
    ; One-sided lines block everything.
    (when (none? (ld 'back-sector)) (return false))
    (when (= (bit-and (tm 'flags) MF-MISSILE) 0)
      (when (!= (bit-and (ld 'flags) ML-BLOCKING) 0) (return false))
      (when (and (none? (tm 'player)) (!= (bit-and (ld 'flags) ML-BLOCKMONSTERS) 0)) (return false)))
    (line-opening w ld)
    (let (o (opening w))
      (when (< (o 'top) (sc 'tm-ceiling-z))
        (set! (sc 'tm-ceiling-z) (o 'top))
        (set! (sc 'ceiling-line) (some li)))
      (when (> (o 'bottom) (sc 'tm-floor-z)) (set! (sc 'tm-floor-z) (o 'bottom)))
      (when (< (o 'low-floor) (sc 'tm-dropoff-z)) (set! (sc 'tm-dropoff-z) (o 'low-floor))))
    ; Special lines are kept to trigger once the move is made. (Chocolate
    ; Doom's spechit overrun emulation is left out.)
    (when (!= (ld 'special) 0)
      (conj (ref sc 'spechit) li)
      (set! (sc 'num-spechit) (+ (sc 'num-spechit) 1)))
    (return true)))

; PIT_CheckThing.
(defn- check-thing (w:&World t:&Mobj):bool
  (when (= (bit-and (t 'flags) (bit-or MF-SOLID (bit-or MF-SPECIAL MF-SHOOTABLE))) 0) (return true))
  (let (sc (scratch w) tm (tm-thing w)
        blockdist (wrap-add (t 'radius) (tm 'radius)))
    (when (or (>= (iabs (wrap-sub (t 'x) (sc 'tm-x))) blockdist)
              (>= (iabs (wrap-sub (t 'y) (sc 'tm-y))) blockdist))
      (return true))
    (when (= (unsafe/cast usize t) (unsafe/cast usize tm)) (return true))
    ; A charging skull slams into it.
    (when (!= (bit-and (tm 'flags) MF-SKULLFLY) 0)
      (let (damage (* (+ (% (p-random w) 8) 1) ((mobj-info (tm 'type)) 'damage)))
        (note-error w (damage-mobj w t (some tm) (some tm) damage))
        (set! (tm 'flags) (bit-and (tm 'flags) (bit-not MF-SKULLFLY)))
        (set! (tm 'mom-x) 0)
        (set! (tm 'mom-y) 0)
        (set! (tm 'mom-z) 0)
        (note-error w (discard (set-mobj-state w tm ((mobj-info (tm 'type)) 'spawn-state))))
        (return false)))
    ; Missiles hit things.
    (when (!= (bit-and (tm 'flags) MF-MISSILE) 0)
      (when (> (tm 'z) (wrap-add (t 'z) (t 'height))) (return true))
      (when (< (wrap-add (tm 'z) (tm 'height)) (t 'z)) (return true))
      (when-some (src (tm 'target))
        (when (or (= (src 'type) (t 'type))
                  (and (= (src 'type) MT-KNIGHT) (= (t 'type) MT-BRUISER))
                  (and (= (src 'type) MT-BRUISER) (= (t 'type) MT-KNIGHT)))
          ; The same species as the shooter: no damage.
          (when (= (unsafe/cast usize t) (unsafe/cast usize src)) (return true))
          (when (!= (t 'type) MT-PLAYER) (return false))))
      (when (= (bit-and (t 'flags) MF-SHOOTABLE) 0)
        (return (= (bit-and (t 'flags) MF-SOLID) 0)))
      (let (damage (* (+ (% (p-random w) 8) 1) ((mobj-info (tm 'type)) 'damage)))
        (note-error w (damage-mobj w t (some tm) (tm 'target) damage)))
      (return false))
    ; Pickups.
    (when (!= (bit-and (t 'flags) MF-SPECIAL) 0)
      (let (solid (!= (bit-and (t 'flags) MF-SOLID) 0))
        (when (!= (bit-and (sc 'tm-flags) MF-PICKUP) 0)
          (note-error w (touch-special-thing w t tm)))
        (return (not solid))))
    (return (= (bit-and (t 'flags) MF-SOLID) 0))))

; P_CheckPosition: whether `m` fits at x,y, leaving the floor and ceiling
; there and the special lines touched in the scratch state.
(defn check-position (w:&World m:&Mobj x:Fixed y:Fixed):(Fallible bool)
  (start-check w m x y)
  (when (!= (bit-and (m 'flags) MF-NOCLIP) 0) (return (ok true)))
  ; Things first, with the box grown by MAXRADIUS: things are in the
  ; blocks of their centres.
  (let (r (block-range w MAXRADIUS) bx (r 'xl))
    (while (<= bx (r 'xh))
      (let (by (r 'yl))
        (while (<= by (r 'yh))
          (when (not (block-things-iterator w bx by check-thing))
            (try (take-error w))
            (return (ok false)))
          (inc! by)))
      (inc! bx)))
  (try (take-error w))
  (let (r (block-range w 0) bx (r 'xl))
    (while (<= bx (r 'xh))
      (let (by (r 'yl))
        (while (<= by (r 'yh))
          (when (not (block-lines-iterator w bx by check-line)) (return (ok false)))
          (inc! by)))
      (inc! bx)))
  (return (ok true)))

; P_TryMove.
(defn try-move (w:&World m:&Mobj x:Fixed y:Fixed):(Fallible bool)
  (let (sc (scratch w))
    (set! (sc 'float-ok) false)
    (when (not (try (check-position w m x y))) (return (ok false)))
    (when (= (bit-and (m 'flags) MF-NOCLIP) 0)
      (when (< (wrap-sub (sc 'tm-ceiling-z) (sc 'tm-floor-z)) (m 'height)) (return (ok false)))
      (set! (sc 'float-ok) true)
      (when (and (= (bit-and (m 'flags) MF-TELEPORT) 0)
                 (< (wrap-sub (sc 'tm-ceiling-z) (m 'z)) (m 'height)))
        (return (ok false)))
      (when (and (= (bit-and (m 'flags) MF-TELEPORT) 0)
                 (> (wrap-sub (sc 'tm-floor-z) (m 'z)) (* 24 FRACUNIT)))
        (return (ok false)))
      (when (and (= (bit-and (m 'flags) (bit-or MF-DROPOFF MF-FLOAT)) 0)
                 (> (wrap-sub (sc 'tm-floor-z) (sc 'tm-dropoff-z)) (* 24 FRACUNIT)))
        (return (ok false))))
    (unset-thing-position w m)
    (let (oldx (m 'x) oldy (m 'y))
      (set! (m 'floor-z) (sc 'tm-floor-z))
      (set! (m 'ceiling-z) (sc 'tm-ceiling-z))
      (set! (m 'x) x)
      (set! (m 'y) y)
      (set-thing-position w m)
      (when (= (bit-and (m 'flags) (bit-or MF-TELEPORT MF-NOCLIP)) 0)
        ; Last touched first. The count is re-read each time, as a
        ; teleport in a special clears it.
        (while (> (sc 'num-spechit) 0)
          (set! (sc 'num-spechit) (- (sc 'num-spechit) 1))
          (let (li ((ref sc 'spechit) (unsafe/cast usize (sc 'num-spechit)))
                ld (line-at (ref w 'level) li)
                side (point-on-line-side (ref w 'level) (m 'x) (m 'y) ld)
                oldside (point-on-line-side (ref w 'level) oldx oldy ld))
            (when (and (!= side oldside) (!= (ld 'special) 0))
              (try (cross-special-line w li oldside m))))))))
  (return (ok true)))

; P_ThingHeightClip: fit a thing to its sector's new heights; false if it
; doesn't fit.
(defn- thing-height-clip (w:&World m:&Mobj):(Fallible bool)
  (let (onfloor (= (m 'z) (m 'floor-z)) sc (scratch w))
    (try (check-position w m (m 'x) (m 'y)))
    (set! (m 'floor-z) (sc 'tm-floor-z))
    (set! (m 'ceiling-z) (sc 'tm-ceiling-z))
    (if onfloor
      (set! (m 'z) (m 'floor-z))
      (when (> (wrap-add (m 'z) (m 'height)) (m 'ceiling-z))
        (set! (m 'z) (wrap-sub (m 'ceiling-z) (m 'height)))))
    (return (ok (>= (wrap-sub (m 'ceiling-z) (m 'floor-z)) (m 'height))))))

; P_HitSlideLine: turn the move along the line.
(defn- hit-slide-line (w:&World li:usize):void
  (let (sc (scratch w) l (ref w 'level) ld (line-at l li))
    (when (= (ld 'slope-type) ST-HORIZONTAL)
      (set! (sc 'tm-ymove) 0)
      (return))
    (when (= (ld 'slope-type) ST-VERTICAL)
      (set! (sc 'tm-xmove) 0)
      (return))
    (let (mo (unwrap (sc 'slide-mo))
          side (point-on-line-side l (mo 'x) (mo 'y) ld)
          lineangle (angle-of (ld 'dx) (ld 'dy)))
      (when (= side 1) (set! lineangle (+ lineangle ANG180)))
      (let (moveangle (angle-of (sc 'tm-xmove) (sc 'tm-ymove))
            deltaangle (- moveangle lineangle))
        (when (> deltaangle ANG180) (set! deltaangle (+ deltaangle ANG180)))
        (let (movelen (aprox-distance (sc 'tm-xmove) (sc 'tm-ymove))
              newlen (fixed-mul movelen (angle-cos deltaangle)))
          (set! (sc 'tm-xmove) (fixed-mul newlen (angle-cos lineangle)))
          (set! (sc 'tm-ymove) (fixed-mul newlen (angle-sin lineangle))))))))

; PTR_SlideTraverse: note the nearest blocking line.
(defn- slide-traverse (w:&World in:&Intercept):bool
  (let (sc (scratch w) l (ref w 'level)
        li (match (in 'of) ((line i) i) ((thing t) 0))
        ld (line-at l li)
        mo (unwrap (sc 'slide-mo))
        blocking (if (= (bit-and (ld 'flags) ML-TWOSIDED) 0)
                   ; The back of a one-sided line doesn't block.
                   (if (!= (point-on-line-side l (mo 'x) (mo 'y) ld) 0) -1 1)
                   (do (line-opening w ld)
                       (let (o (opening w))
                         (if (or (< (o 'range) (mo 'height))
                                 (< (wrap-sub (o 'top) (mo 'z)) (mo 'height))
                                 (> (wrap-sub (o 'bottom) (mo 'z)) (* 24 FRACUNIT)))
                           1 0)))))
    (when (= blocking -1) (return true))
    (when (= blocking 0) (return true))
    (when (< (in 'frac) (sc 'best-slide-frac))
      (set! (sc 'second-slide-frac) (sc 'best-slide-frac))
      (set! (sc 'second-slide-line) (sc 'best-slide-line))
      (set! (sc 'best-slide-frac) (in 'frac))
      (set! (sc 'best-slide-line) (some li)))
    (return false)))

(defn- stairstep (w:&World mo:&Mobj):(Fallible void)
  (when (not (try (try-move w mo (mo 'x) (wrap-add (mo 'y) (mo 'mom-y)))))
    (try (try-move w mo (wrap-add (mo 'x) (mo 'mom-x)) (mo 'y))))
  (return (ok)))

; P_SlideMove: along the wall the move ran into, or stepping one axis at a
; time when that doesn't work.
(defn slide-move (w:&World mo:&Mobj):(Fallible void)
  (let (sc (scratch w) hitcount 0)
    (set! (sc 'slide-mo) (some mo))
    (while true
      (inc! hitcount)
      (when (= hitcount 3)
        (try (stairstep w mo))
        (return (ok)))
      (let (r (mo 'radius)
            leadx (if (> (mo 'mom-x) 0) (wrap-add (mo 'x) r) (wrap-sub (mo 'x) r))
            trailx (if (> (mo 'mom-x) 0) (wrap-sub (mo 'x) r) (wrap-add (mo 'x) r))
            leady (if (> (mo 'mom-y) 0) (wrap-add (mo 'y) r) (wrap-sub (mo 'y) r))
            traily (if (> (mo 'mom-y) 0) (wrap-sub (mo 'y) r) (wrap-add (mo 'y) r)))
        (set! (sc 'best-slide-frac) (+ FRACUNIT 1))
        (path-traverse w leadx leady (wrap-add leadx (mo 'mom-x)) (wrap-add leady (mo 'mom-y))
                       PT-ADDLINES slide-traverse)
        (path-traverse w trailx leady (wrap-add trailx (mo 'mom-x)) (wrap-add leady (mo 'mom-y))
                       PT-ADDLINES slide-traverse)
        (path-traverse w leadx traily (wrap-add leadx (mo 'mom-x)) (wrap-add traily (mo 'mom-y))
                       PT-ADDLINES slide-traverse))
      ; Nothing hit: the move must have caught a corner.
      (when (= (sc 'best-slide-frac) (+ FRACUNIT 1))
        (try (stairstep w mo))
        (return (ok)))
      ; Up to the wall, less a fudge.
      (set! (sc 'best-slide-frac) (- (sc 'best-slide-frac) 0x800))
      (when (> (sc 'best-slide-frac) 0)
        (let (newx (fixed-mul (mo 'mom-x) (sc 'best-slide-frac))
              newy (fixed-mul (mo 'mom-y) (sc 'best-slide-frac)))
          (when (not (try (try-move w mo (wrap-add (mo 'x) newx) (wrap-add (mo 'y) newy))))
            (try (stairstep w mo))
            (return (ok)))))
      ; The rest of the move, along the wall.
      (set! (sc 'best-slide-frac) (- FRACUNIT (+ (sc 'best-slide-frac) 0x800)))
      (when (> (sc 'best-slide-frac) FRACUNIT) (set! (sc 'best-slide-frac) FRACUNIT))
      (when (<= (sc 'best-slide-frac) 0) (return (ok)))
      (set! (sc 'tm-xmove) (fixed-mul (mo 'mom-x) (sc 'best-slide-frac)))
      (set! (sc 'tm-ymove) (fixed-mul (mo 'mom-y) (sc 'best-slide-frac)))
      (hit-slide-line w (unwrap-or (sc 'best-slide-line) 0))
      (set! (mo 'mom-x) (sc 'tm-xmove))
      (set! (mo 'mom-y) (sc 'tm-ymove))
      (when (try (try-move w mo (wrap-add (mo 'x) (sc 'tm-xmove)) (wrap-add (mo 'y) (sc 'tm-ymove))))
        (return (ok)))))
  (return (ok)))

; PTR_AimTraverse: narrow the slopes through each opening; stop at the
; first shootable thing between them.
(defn- aim-traverse (w:&World in:&Intercept):bool
  (let (sc (scratch w) l (ref w 'level))
    (match (in 'of)
      ((line li)
       (let (ld (line-at l li))
         (when (= (bit-and (ld 'flags) ML-TWOSIDED) 0) (return false))
         (line-opening w ld)
         (let (o (opening w))
           (when (>= (o 'bottom) (o 'top)) (return false))
           (let (dist (fixed-mul (sc 'attack-range) (in 'frac))
                 front (sector-at l (unwrap-or (ld 'front-sector) 0)))
             (when (or (none? (ld 'back-sector))
                       (!= (front 'floor-height) ((sector-at l (unwrap-or (ld 'back-sector) 0)) 'floor-height)))
               (let (slope (fixed-div (wrap-sub (o 'bottom) (sc 'shoot-z)) dist))
                 (when (> slope (sc 'bottom-slope)) (set! (sc 'bottom-slope) slope))))
             (when (or (none? (ld 'back-sector))
                       (!= (front 'ceiling-height) ((sector-at l (unwrap-or (ld 'back-sector) 0)) 'ceiling-height)))
               (let (slope (fixed-div (wrap-sub (o 'top) (sc 'shoot-z)) dist))
                 (when (< slope (sc 'top-slope)) (set! (sc 'top-slope) slope))))
             (return (> (sc 'top-slope) (sc 'bottom-slope)))))))
      ((thing th)
       (when (= (unsafe/cast usize th) (unsafe/cast usize (unwrap (sc 'shoot-thing)))) (return true))
       (when (= (bit-and (th 'flags) MF-SHOOTABLE) 0) (return true))
       (let (dist (fixed-mul (sc 'attack-range) (in 'frac))
             top (fixed-div (wrap-sub (wrap-add (th 'z) (th 'height)) (sc 'shoot-z)) dist))
         (when (< top (sc 'bottom-slope)) (return true))
         (let (bottom (fixed-div (wrap-sub (th 'z) (sc 'shoot-z)) dist))
           (when (> bottom (sc 'top-slope)) (return true))
           (when (> top (sc 'top-slope)) (set! top (sc 'top-slope)))
           (when (< bottom (sc 'bottom-slope)) (set! bottom (sc 'bottom-slope)))
           (set! (sc 'aim-slope) (/ (wrap-add top bottom) 2))
           (set! (sc 'line-target) (some th))
           (return false)))))))

; PTR_ShootTraverse: the bullet stops at the first wall or thing it meets,
; leaving a puff or blood.
(defn- shoot-traverse (w:&World in:&Intercept):bool
  (let (sc (scratch w) l (ref w 'level))
    (match (in 'of)
      ((line li)
       (let (ld (line-at l li) hit false)
         (when (!= (ld 'special) 0)
           (note-error w (shoot-special-line w (unwrap (sc 'shoot-thing)) li)))
         (if (= (bit-and (ld 'flags) ML-TWOSIDED) 0)
           (set! hit true)
           (do (line-opening w ld)
               (let (o (opening w)
                     dist (fixed-mul (sc 'attack-range) (in 'frac))
                     front (sector-at l (unwrap-or (ld 'front-sector) 0)))
                 (match (ld 'back-sector)
                   ; A two-sided line missing its back (e6y's emulation).
                   ((none)
                    (when (> (fixed-div (wrap-sub (o 'bottom) (sc 'shoot-z)) dist) (sc 'aim-slope)) (set! hit true))
                    (when (< (fixed-div (wrap-sub (o 'top) (sc 'shoot-z)) dist) (sc 'aim-slope)) (set! hit true)))
                   ((some bi)
                    (let (back (sector-at l bi))
                      (when (and (!= (front 'floor-height) (back 'floor-height))
                                 (> (fixed-div (wrap-sub (o 'bottom) (sc 'shoot-z)) dist) (sc 'aim-slope)))
                        (set! hit true))
                      (when (and (not hit) (!= (front 'ceiling-height) (back 'ceiling-height))
                                 (< (fixed-div (wrap-sub (o 'top) (sc 'shoot-z)) dist) (sc 'aim-slope)))
                        (set! hit true))))))))
         (when (not hit) (return true))
         ; Hit the wall: the puff goes a little in front of it.
         (let (frac (wrap-sub (in 'frac) (fixed-div (* 4 FRACUNIT) (sc 'attack-range)))
               tr (sc 'trace)
               x (wrap-add (tr 'x) (fixed-mul (tr 'dx) frac))
               y (wrap-add (tr 'y) (fixed-mul (tr 'dy) frac))
               z (wrap-add (sc 'shoot-z) (fixed-mul (sc 'aim-slope) (fixed-mul frac (sc 'attack-range))))
               front (sector-at l (unwrap-or (ld 'front-sector) 0))
               sky (l 'sky-flat))
           (when (= (front 'ceiling-pic) sky)
             ; Don't shoot the sky.
             (when (> z (front 'ceiling-height)) (return false))
             (when-some (bi (ld 'back-sector))
               (when (= ((sector-at l bi) 'ceiling-pic) sky) (return false))))
           (note-error w (spawn-puff w x y z))
           (return false))))
      ((thing th)
       (when (= (unsafe/cast usize th) (unsafe/cast usize (unwrap (sc 'shoot-thing)))) (return true))
       (when (= (bit-and (th 'flags) MF-SHOOTABLE) 0) (return true))
       (let (dist (fixed-mul (sc 'attack-range) (in 'frac))
             top (fixed-div (wrap-sub (wrap-add (th 'z) (th 'height)) (sc 'shoot-z)) dist))
         (when (< top (sc 'aim-slope)) (return true))
         (when (> (fixed-div (wrap-sub (th 'z) (sc 'shoot-z)) dist) (sc 'aim-slope)) (return true))
         (let (frac (wrap-sub (in 'frac) (fixed-div (* 10 FRACUNIT) (sc 'attack-range)))
               tr (sc 'trace)
               x (wrap-add (tr 'x) (fixed-mul (tr 'dx) frac))
               y (wrap-add (tr 'y) (fixed-mul (tr 'dy) frac))
               z (wrap-add (sc 'shoot-z) (fixed-mul (sc 'aim-slope) (fixed-mul frac (sc 'attack-range)))))
           (if (!= (bit-and (th 'flags) MF-NOBLOOD) 0)
             (note-error w (spawn-puff w x y z))
             (note-error w (spawn-blood w x y z (sc 'la-damage))))
           (when (!= (sc 'la-damage) 0)
             (note-error w (damage-mobj w th (sc 'shoot-thing) (sc 'shoot-thing) (sc 'la-damage))))
           (return false)))))))

; The dummy P_SubstNullMobj stands in for a missing shooter.
(defn- shooter-or-dummy (w:&World t:?&Mobj):(Fallible &Mobj)
  (match t
    ((some m) (return (ok m)))
    ((none) (fail "P_AimLineAttack: no shooter (vanilla reads a dummy mobj)"))))

; P_AimLineAttack: the slope to the first thing in the line of fire, or 0;
; the thing is left in the scratch line-target.
(defn aim-line-attack (w:&World t1:?&Mobj angle:Angle distance:Fixed):(Fallible Fixed)
  (let (t (try (shooter-or-dummy w t1)) sc (scratch w)
        fa (bit-shr angle ANGLETOFINESHIFT)
        x2 (wrap-add (t 'x) (wrap-mul (bit-shr distance FRACBITS) (finecosine (as usize fa))))
        y2 (wrap-add (t 'y) (wrap-mul (bit-shr distance FRACBITS) (finesine (as usize fa)))))
    (set! (sc 'shoot-thing) (some t))
    (set! (sc 'shoot-z) (wrap-add (wrap-add (t 'z) (bit-shr (t 'height) 1)) (* 8 FRACUNIT)))
    ; The slopes of the view's top and bottom edges.
    (set! (sc 'top-slope) (/ (* 100 FRACUNIT) 160))
    (set! (sc 'bottom-slope) (/ (* -100 FRACUNIT) 160))
    (set! (sc 'attack-range) distance)
    (set! (sc 'line-target) none)
    (path-traverse w (t 'x) (t 'y) x2 y2 (bit-or PT-ADDLINES PT-ADDTHINGS) aim-traverse)
    (try (take-error w))
    (return (ok (if (some? (sc 'line-target)) (sc 'aim-slope) 0)))))

; P_LineAttack: a hitscan shot.
(defn line-attack (w:&World t1:&Mobj angle:Angle distance:Fixed slope:Fixed damage:i32):(Fallible void)
  (let (sc (scratch w)
        fa (bit-shr angle ANGLETOFINESHIFT)
        x2 (wrap-add (t1 'x) (wrap-mul (bit-shr distance FRACBITS) (finecosine (as usize fa))))
        y2 (wrap-add (t1 'y) (wrap-mul (bit-shr distance FRACBITS) (finesine (as usize fa)))))
    (set! (sc 'shoot-thing) (some t1))
    (set! (sc 'la-damage) damage)
    (set! (sc 'shoot-z) (wrap-add (wrap-add (t1 'z) (bit-shr (t1 'height) 1)) (* 8 FRACUNIT)))
    (set! (sc 'attack-range) distance)
    (set! (sc 'aim-slope) slope)
    (path-traverse w (t1 'x) (t1 'y) x2 y2 (bit-or PT-ADDLINES PT-ADDTHINGS) shoot-traverse)
    (try (take-error w)))
  (return (ok)))

; PTR_UseTraverse: the first special line in reach is used; a wall in the
; way says "oof".
(defn- use-traverse (w:&World in:&Intercept):bool
  (let (sc (scratch w) l (ref w 'level)
        li (match (in 'of) ((line i) i) ((thing t) 0))
        ld (line-at l li)
        user (unwrap (sc 'use-thing)))
    (when (= (ld 'special) 0)
      (line-opening w ld)
      (when (<= ((opening w) 'range) 0)
        (start-sound w (some user) SFX-NOWAY)
        (return false))
      (return true))
    (let (side (if (= (point-on-line-side l (user 'x) (user 'y) ld) 1) 1 0))
      (note-error w (discard (use-special-line w user li side)))
      (return false))))

; P_UseLines.
(defn use-lines (w:&World p:&Player):(Fallible void)
  (let (mo (unwrap (p 'mo)) sc (scratch w)
        fa (bit-shr (mo 'angle) ANGLETOFINESHIFT)
        x1 (mo 'x) y1 (mo 'y)
        x2 (wrap-add x1 (wrap-mul (bit-shr USERANGE FRACBITS) (finecosine (as usize fa))))
        y2 (wrap-add y1 (wrap-mul (bit-shr USERANGE FRACBITS) (finesine (as usize fa)))))
    (set! (sc 'use-thing) (some mo))
    (path-traverse w x1 y1 x2 y2 PT-ADDLINES use-traverse)
    (try (take-error w)))
  (return (ok)))

; PIT_RadiusAttack.
(defn- radius-attack-thing (w:&World t:&Mobj):bool
  (when (= (bit-and (t 'flags) MF-SHOOTABLE) 0) (return true))
  ; The bosses shrug off blasts.
  (when (or (= (t 'type) MT-CYBORG) (= (t 'type) MT-SPIDER)) (return true))
  (let (sc (scratch w) spot (unwrap (sc 'bomb-spot))
        dx (iabs (wrap-sub (t 'x) (spot 'x)))
        dy (iabs (wrap-sub (t 'y) (spot 'y)))
        dist (bit-shr (wrap-sub (if (> dx dy) dx dy) (t 'radius)) FRACBITS))
    (when (< dist 0) (set! dist 0))
    (when (>= dist (sc 'bomb-damage)) (return true))
    (match (check-sight w t spot)
      ((ok seen)
       (when seen
         (note-error w (damage-mobj w t (some spot) (sc 'bomb-source) (- (sc 'bomb-damage) dist)))))
      ((err e) (note-error w (err e))))
    (return true)))

; P_RadiusAttack.
(defn radius-attack (w:&World spot:&Mobj source:?&Mobj damage:i32):(Fallible void)
  (let (sc (scratch w) l (ref w 'level)
        dist (bit-shl (+ damage (bit-shr MAXRADIUS FRACBITS)) FRACBITS)
        yh (bit-shr (wrap-sub (wrap-add (spot 'y) dist) (l 'bmap-org-y)) MAPBLOCKSHIFT)
        yl (bit-shr (wrap-sub (wrap-sub (spot 'y) dist) (l 'bmap-org-y)) MAPBLOCKSHIFT)
        xh (bit-shr (wrap-sub (wrap-add (spot 'x) dist) (l 'bmap-org-x)) MAPBLOCKSHIFT)
        xl (bit-shr (wrap-sub (wrap-sub (spot 'x) dist) (l 'bmap-org-x)) MAPBLOCKSHIFT))
    (set! (sc 'bomb-spot) (some spot))
    (set! (sc 'bomb-source) source)
    (set! (sc 'bomb-damage) damage)
    (let (y yl)
      (while (<= y yh)
        (let (x xl)
          (while (<= x xh)
            (block-things-iterator w x y radius-attack-thing)
            (inc! x)))
        (inc! y)))
    (try (take-error w)))
  (return (ok)))

; PIT_ChangeSector: a thing in a moving sector is refitted, crushed or
; squeezed.
(defn- change-sector-thing (w:&World t:&Mobj):bool
  (match (thing-height-clip w t)
    ((err e) (note-error w (err e)) (return true))
    ((ok fits) (when fits (return true))))
  ; Bodies are crushed to gibs.
  (when (<= (t 'health) 0)
    (note-error w (discard (set-mobj-state w t S-GIBS)))
    (set! (t 'flags) (bit-and (t 'flags) (bit-not MF-SOLID)))
    (set! (t 'height) 0)
    (set! (t 'radius) 0)
    (return true))
  ; Dropped items are crushed away.
  (when (!= (bit-and (t 'flags) MF-DROPPED) 0)
    (remove-mobj w t)
    (return true))
  (when (= (bit-and (t 'flags) MF-SHOOTABLE) 0) (return true))
  (let (sc (scratch w))
    (set! (sc 'no-fit) true)
    (when (and (sc 'crush-change) (= (bit-and (w 'level-time) 3) 0))
      (note-error w (damage-mobj w t none none 10))
      ; Blood sprays in a random direction.
      (let (mo (spawn-mobj w (t 'x) (t 'y) (wrap-add (t 'z) (/ (t 'height) 2)) MT-BLOOD))
        (set! (mo 'mom-x) (bit-shl (p-sub-random (ref w 'random)) 12))
        (set! (mo 'mom-y) (bit-shl (p-sub-random (ref w 'random)) 12)))))
  (return true))

; P_ChangeSector: true if something doesn't fit.
(defn change-sector (w:&World sector:usize crunch:bool):(Fallible bool)
  (let (sc (scratch w) bb ((sector-at (ref w 'level) sector) 'block-box))
    (set! (sc 'no-fit) false)
    (set! (sc 'crush-change) crunch)
    (let (x (bb 'left))
      (while (<= x (bb 'right))
        (let (y (bb 'bottom))
          (while (<= y (bb 'top))
            (block-things-iterator w x y change-sector-thing)
            (inc! y)))
        (inc! x)))
    (try (take-error w))
    (return (ok (sc 'no-fit)))))
