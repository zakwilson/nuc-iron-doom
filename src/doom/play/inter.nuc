(import-use doom.error)
(import-use doom.play.world)

(defn damage-mobj (w:&World target:&Mobj inflictor:?&Mobj source:?&Mobj damage:i32):(Fallible void)
  (return (ok)))

(defn touch-special-thing (w:&World special:&Mobj toucher:&Mobj):(Fallible void)
  (return (ok)))
