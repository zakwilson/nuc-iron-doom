; Interactions: picking things up, damage and death.

(ns doom.play.inter)

(import-use nucleus.math)
(import-use doom.error)
(import-use doom.util)
(import-use doom.fixed)
(import-use doom.rand)
(import-use doom.info)
(import-use doom.play.defs)
(import-use doom.play.map)
(import-use doom.play.world)
(import-use doom.play.mobj)
(import-use doom.play.pspr)

(defconst BONUSADD 6)
; Dehacked's defaults.
(defconst MAX-HEALTH-BONUS 200)
(defconst MAX-ARMOR-BONUS 200)
(defconst GREEN-ARMOR-CLASS 1)
(defconst BLUE-ARMOR-CLASS 2)
(defconst SOULSPHERE-HEALTH 100)
(defconst MAX-SOULSPHERE 200)
(defconst MEGASPHERE-HEALTH 200)

(defn- ammo-of (p:&Player a:i32):i32 (return (aref (p 'ammo) (as i64 a))))
(defn- owns? (p:&Player wp:i32):bool (return (aref (p 'weapon-owned) (as i64 wp))))

; P_GiveAmmo: `num` clips' worth, or half a clip for 0 (a dropped clip).
; Switches up from the fist or pistol when the player had none.
(defn- give-ammo (w:&World p:&Player ammo:i32 num:i32):(Fallible bool)
  (when (= ammo AM-NOAMMO) (return (ok false)))
  (when (>= ammo NUMAMMO) (fail "P_GiveAmmo: bad type " ammo))
  (let (i (as i64 ammo) skill ((ref w 'rules) 'skill)
        n (if (!= num 0) (* num (aref CLIPAMMO i)) (/ (aref CLIPAMMO i) 2)))
    (when (= (aref (p 'ammo) i) (aref (p 'max-ammo) i)) (return (ok false)))
    ; Double for the trainer and nightmare.
    (when (or (= skill SK-BABY) (= skill SK-NIGHTMARE)) (set! n (bit-shl n 1)))
    (let (old (aref (p 'ammo) i) rw (p 'ready-weapon))
      (set! (aref (p 'ammo) i) (min (+ old n) (aref (p 'max-ammo) i)))
      ; Already had some: don't change weapons.
      (when (!= old 0) (return (ok true)))
      (case ammo
        AM-CLIP (when (= rw WP-FIST)
                  (set! (p 'pending-weapon) (if (owns? p WP-CHAINGUN) WP-CHAINGUN WP-PISTOL)))
        AM-SHELL (when (and (or (= rw WP-FIST) (= rw WP-PISTOL)) (owns? p WP-SHOTGUN))
                   (set! (p 'pending-weapon) WP-SHOTGUN))
        AM-CELL (when (and (or (= rw WP-FIST) (= rw WP-PISTOL)) (owns? p WP-PLASMA))
                  (set! (p 'pending-weapon) WP-PLASMA))
        AM-MISL (when (and (= rw WP-FIST) (owns? p WP-MISSILE))
                  (set! (p 'pending-weapon) WP-MISSILE))
        0)
      (return (ok true)))))

; P_GiveWeapon. A cooperative game's placed weapons stay for the others.
(defn- give-weapon (w:&World pi:usize weapon:i32 dropped:bool):(Fallible bool)
  (let (p (player-at w pi) r (ref w 'rules) a ((weapon-info weapon) 'ammo))
    (when (and (r 'netgame) (!= (r 'deathmatch) 2) (not dropped))
      ; Leave placed weapons forever in net games.
      (when (owns? p weapon) (return (ok false)))
      (set! (p 'bonus-count) (+ (p 'bonus-count) BONUSADD))
      (set! (aref (p 'weapon-owned) (as i64 weapon)) true)
      (try (give-ammo w p a (if (!= (r 'deathmatch) 0) 5 2)))
      (set! (p 'pending-weapon) weapon)
      (when (= pi (unsafe/cast usize (r 'console-player))) (start-sound w none SFX-WPNUP))
      (return (ok false)))
    (let (gaveammo (if (!= a AM-NOAMMO) (try (give-ammo w p a (if dropped 1 2))) false)
          gaveweapon (not (owns? p weapon)))
      (when gaveweapon
        (set! (aref (p 'weapon-owned) (as i64 weapon)) true)
        (set! (p 'pending-weapon) weapon))
      (return (ok (or gaveweapon gaveammo))))))

; P_GiveBody: health up to 100.
(defn- give-body (p:&Player num:i32):bool
  (when (>= (p 'health) MAXHEALTH) (return false))
  (set! (p 'health) (min (+ (p 'health) num) MAXHEALTH))
  (set! ((unwrap (p 'mo)) 'health) (p 'health))
  (return true))

; P_GiveArmor.
(defn- give-armor (p:&Player armortype:i32):bool
  (let (hits (* armortype 100))
    (when (>= (p 'armor-points) hits) (return false))
    (set! (p 'armor-type) armortype)
    (set! (p 'armor-points) hits)
    (return true)))

(defn- give-card (p:&Player card:i32):void
  (when (aref (p 'cards) (as i64 card)) (return))
  (set! (p 'bonus-count) BONUSADD)
  (set! (aref (p 'cards) (as i64 card)) true))

; P_GivePower.
(defn give-power (p:&Player power:i32):bool
  (let (i (as i64 power))
    (case power
      PW-INVULNERABILITY (do (set! (aref (p 'powers) i) INVULNTICS) (return true))
      PW-INVISIBILITY (do (set! (aref (p 'powers) i) INVISTICS)
                          (let (mo (unwrap (p 'mo))) (set! (mo 'flags) (bit-or (mo 'flags) MF-SHADOW)))
                          (return true))
      PW-INFRARED (do (set! (aref (p 'powers) i) INFRATICS) (return true))
      PW-IRONFEET (do (set! (aref (p 'powers) i) IRONTICS) (return true))
      PW-STRENGTH (do (give-body p 100) (set! (aref (p 'powers) i) 1) (return true))
      0)
    (when (!= (aref (p 'powers) i) 0) (return false))
    (set! (aref (p 'powers) i) 1)
    (return true)))

; A key: the message only the first time; in a net game it stays for others.
(defn- key (w:&World p:&Player card:i32 msg:CStr):bool
  (when (not (aref (p 'cards) (as i64 card))) (set! (p 'message) (some msg)))
  (give-card p card)
  (return (not ((ref w 'rules) 'netgame))))

; P_TouchSpecialThing.
(defn touch-special-thing (w:&World special:&Mobj toucher:&Mobj):(Fallible void)
  (let (delta (wrap-sub (special 'z) (toucher 'z)))
    ; Out of reach.
    (when (or (> delta (toucher 'height)) (< delta (* -8 FRACUNIT))) (return (ok))))
  (when (<= (toucher 'health) 0) (return (ok)))
  (let (pi (unwrap-or (toucher 'player) 0) p (player-at w pi) sound SFX-ITEMUP
        dropped (!= (bit-and (special 'flags) MF-DROPPED) 0)
        msg:?CStr none take true)
    (case (special 'sprite)
      SPR-ARM1 (do (set! take (give-armor p GREEN-ARMOR-CLASS)) (set! msg (some "Picked up the armor.")))
      SPR-ARM2 (do (set! take (give-armor p BLUE-ARMOR-CLASS)) (set! msg (some "Picked up the MegaArmor!")))
      ; The bonuses can go over 100%.
      SPR-BON1 (do (set! (p 'health) (min (+ (p 'health) 1) MAX-HEALTH-BONUS))
                   (set! ((unwrap (p 'mo)) 'health) (p 'health))
                   (set! msg (some "Picked up a health bonus.")))
      SPR-BON2 (do (set! (p 'armor-points) (min (+ (p 'armor-points) 1) MAX-ARMOR-BONUS))
                   (when (= (p 'armor-type) 0) (set! (p 'armor-type) 1))
                   (set! msg (some "Picked up an armor bonus.")))
      SPR-SOUL (do (set! (p 'health) (min (+ (p 'health) SOULSPHERE-HEALTH) MAX-SOULSPHERE))
                   (set! ((unwrap (p 'mo)) 'health) (p 'health))
                   (set! msg (some "Supercharge!"))
                   (set! sound SFX-GETPOW))
      SPR-MEGA (if (!= ((ref w 'rules) 'mode) COMMERCIAL)
                 (set! take false)
                 (do (set! (p 'health) MEGASPHERE-HEALTH)
                     (set! ((unwrap (p 'mo)) 'health) (p 'health))
                     (give-armor p 2)
                     (set! msg (some "MegaSphere!"))
                     (set! sound SFX-GETPOW)))
      ; Keys: the message is set inside, as it depends on having it already.
      SPR-BKEY (set! take (key w p IT-BLUECARD "Picked up a blue keycard."))
      SPR-YKEY (set! take (key w p IT-YELLOWCARD "Picked up a yellow keycard."))
      SPR-RKEY (set! take (key w p IT-REDCARD "Picked up a red keycard."))
      SPR-BSKU (set! take (key w p IT-BLUESKULL "Picked up a blue skull key."))
      SPR-YSKU (set! take (key w p IT-YELLOWSKULL "Picked up a yellow skull key."))
      SPR-RSKU (set! take (key w p IT-REDSKULL "Picked up a red skull key."))
      SPR-STIM (do (set! take (give-body p 10)) (set! msg (some "Picked up a stimpack.")))
      SPR-MEDI (do (set! take (give-body p 25))
                   ; Vanilla checks after healing, so this message never shows.
                   (set! msg (some (if (< (p 'health) 25)
                                     "Picked up a medikit that you REALLY need!"
                                     "Picked up a medikit."))))
      SPR-PINV (do (set! take (give-power p PW-INVULNERABILITY))
                   (set! msg (some "Invulnerability!")) (set! sound SFX-GETPOW))
      SPR-PSTR (do (set! take (give-power p PW-STRENGTH))
                   (set! msg (some "Berserk!"))
                   (when (!= (p 'ready-weapon) WP-FIST) (set! (p 'pending-weapon) WP-FIST))
                   (set! sound SFX-GETPOW))
      SPR-PINS (do (set! take (give-power p PW-INVISIBILITY))
                   (set! msg (some "Partial Invisibility")) (set! sound SFX-GETPOW))
      SPR-SUIT (do (set! take (give-power p PW-IRONFEET))
                   (set! msg (some "Radiation Shielding Suit")) (set! sound SFX-GETPOW))
      SPR-PMAP (do (set! take (give-power p PW-ALLMAP))
                   (set! msg (some "Computer Area Map")) (set! sound SFX-GETPOW))
      SPR-PVIS (do (set! take (give-power p PW-INFRARED))
                   (set! msg (some "Light Amplification Visor")) (set! sound SFX-GETPOW))
      SPR-CLIP (do (set! take (try (give-ammo w p AM-CLIP (if dropped 0 1))))
                   (set! msg (some "Picked up a clip.")))
      SPR-AMMO (do (set! take (try (give-ammo w p AM-CLIP 5))) (set! msg (some "Picked up a box of bullets.")))
      SPR-ROCK (do (set! take (try (give-ammo w p AM-MISL 1))) (set! msg (some "Picked up a rocket.")))
      SPR-BROK (do (set! take (try (give-ammo w p AM-MISL 5))) (set! msg (some "Picked up a box of rockets.")))
      SPR-CELL (do (set! take (try (give-ammo w p AM-CELL 1))) (set! msg (some "Picked up an energy cell.")))
      SPR-CELP (do (set! take (try (give-ammo w p AM-CELL 5))) (set! msg (some "Picked up an energy cell pack.")))
      SPR-SHEL (do (set! take (try (give-ammo w p AM-SHELL 1))) (set! msg (some "Picked up 4 shotgun shells.")))
      SPR-SBOX (do (set! take (try (give-ammo w p AM-SHELL 5))) (set! msg (some "Picked up a box of shotgun shells.")))
      SPR-BPAK (do (when (not (p 'backpack))
                     (dotimes (i:usize 4)
                       (set! (aref (p 'max-ammo) (as i64 i)) (* (aref (p 'max-ammo) (as i64 i)) 2)))
                     (set! (p 'backpack) true))
                   (dotimes (i:usize 4) (try (give-ammo w p (unsafe/cast i32 i) 1)))
                   (set! msg (some "Picked up a backpack full of ammo!")))
      SPR-BFUG (do (set! take (try (give-weapon w pi WP-BFG false)))
                   (set! msg (some "You got the BFG9000!  Oh, yes.")) (set! sound SFX-WPNUP))
      SPR-MGUN (do (set! take (try (give-weapon w pi WP-CHAINGUN dropped)))
                   (set! msg (some "You got the chaingun!")) (set! sound SFX-WPNUP))
      SPR-CSAW (do (set! take (try (give-weapon w pi WP-CHAINSAW false)))
                   (set! msg (some "A chainsaw!  Find some meat!")) (set! sound SFX-WPNUP))
      SPR-LAUN (do (set! take (try (give-weapon w pi WP-MISSILE false)))
                   (set! msg (some "You got the rocket launcher!")) (set! sound SFX-WPNUP))
      SPR-PLAS (do (set! take (try (give-weapon w pi WP-PLASMA false)))
                   (set! msg (some "You got the plasma gun!")) (set! sound SFX-WPNUP))
      SPR-SHOT (do (set! take (try (give-weapon w pi WP-SHOTGUN dropped)))
                   (set! msg (some "You got the shotgun!")) (set! sound SFX-WPNUP))
      SPR-SGN2 (do (set! take (try (give-weapon w pi WP-SUPERSHOTGUN dropped)))
                   (set! msg (some "You got the super shotgun!")) (set! sound SFX-WPNUP))
      (fail "P_SpecialThing: Unknown gettable thing"))
    (when (not take) (return (ok)))
    (when-some (m msg) (set! (p 'message) (some m)))
    (when (!= (bit-and (special 'flags) MF-COUNTITEM) 0)
      (set! (p 'item-count) (+ (p 'item-count) 1)))
    (remove-mobj w special)
    (set! (p 'bonus-count) (+ (p 'bonus-count) BONUSADD))
    (when (= pi (unsafe/cast usize ((ref w 'rules) 'console-player)))
      (start-sound w none sound)))
  (return (ok)))

; P_KillMobj.
(defn- kill-mobj (w:&World source:?&Mobj target:&Mobj):(Fallible void)
  (set! (target 'flags) (bit-and (target 'flags) (bit-not (bit-or (bit-or MF-SHOOTABLE MF-FLOAT) MF-SKULLFLY))))
  (when (!= (target 'type) MT-SKULL)
    (set! (target 'flags) (bit-and (target 'flags) (bit-not MF-NOGRAVITY))))
  (set! (target 'flags) (bit-or (target 'flags) (bit-or MF-CORPSE MF-DROPOFF)))
  (set! (target 'height) (bit-shr (target 'height) 2))
  (let (sp:?usize (match source ((some s) (s 'player)) ((none) none)))
    (match sp
      ((some si)
       ; Count for intermission.
       (let (sp (player-at w si))
         (when (!= (bit-and (target 'flags) MF-COUNTKILL) 0)
           (set! (sp 'kill-count) (+ (sp 'kill-count) 1)))
         (when-some (ti (target 'player))
           (set! (aref (sp 'frags) (as i64 ti)) (+ (aref (sp 'frags) (as i64 ti)) 1)))))
      ((none)
       ; Count all monster deaths, even those caused by other monsters.
       (when (and (not ((ref w 'rules) 'netgame)) (!= (bit-and (target 'flags) MF-COUNTKILL) 0))
         (let (p0 (player-at w 0)) (set! (p0 'kill-count) (+ (p0 'kill-count) 1)))))))
  (when-some (ti (target 'player))
    (let (tp (player-at w ti))
      ; Count environment kills against you.
      (when (none? source)
        (set! (aref (tp 'frags) (as i64 ti)) (+ (aref (tp 'frags) (as i64 ti)) 1)))
      (set! (target 'flags) (bit-and (target 'flags) (bit-not MF-SOLID)))
      (set! (tp 'state) PST-DEAD)
      (try (drop-weapon w ti))))
  (let (inf (mobj-info (target 'type)))
    (if (and (< (target 'health) (- 0 (inf 'spawn-health))) (!= (inf 'xdeath-state) 0))
      (try (set-mobj-state w target (inf 'xdeath-state)))
      (try (set-mobj-state w target (inf 'death-state)))))
  (set! (target 'tics) (- (target 'tics) (bit-and (p-random w) 3)))
  (when (< (target 'tics) 1) (set! (target 'tics) 1))
  ; Drop stuff: special versions of items.
  (let (item (case (target 'type)
               (:or MT-WOLFSS MT-POSSESSED) MT-CLIP
               MT-SHOTGUY MT-SHOTGUN
               MT-CHAINGUY MT-CHAINGUN
               -1))
    (when (>= item 0)
      (let (mo (spawn-mobj w (target 'x) (target 'y) ONFLOORZ item))
        (set! (mo 'flags) (bit-or (mo 'flags) MF-DROPPED)))))
  (return (ok)))

; P_DamageMobj: `inflictor` pushes the target; `source` is who to blame.
(defn damage-mobj (w:&World target:&Mobj inflictor:?&Mobj source:?&Mobj damage:i32):(Fallible void)
  (when (= (bit-and (target 'flags) MF-SHOOTABLE) 0) (return (ok)))
  (when (<= (target 'health) 0) (return (ok)))
  (when (!= (bit-and (target 'flags) MF-SKULLFLY) 0)
    (set! (target 'mom-x) 0)
    (set! (target 'mom-y) 0)
    (set! (target 'mom-z) 0))
  (let (r (ref w 'rules) player (mobj-player w target) inf (mobj-info (target 'type)) dmg damage
        source-saw (match source
                     ((some s) (match (mobj-player w s)
                                 ((some sp) (= (sp 'ready-weapon) WP-CHAINSAW))
                                 ((none) false)))
                     ((none) false)))
    ; Half damage in trainer mode.
    (when (and (some? player) (= (r 'skill) SK-BABY)) (set! dmg (bit-shr dmg 1)))
    ; Push the target away from the inflictor, unless it's the chainsaw.
    (when-some (inflictor inflictor)
      (when (and (= (bit-and (target 'flags) MF-NOCLIP) 0) (not source-saw))
        (let (ang (point-to-angle2 (inflictor 'x) (inflictor 'y) (target 'x) (target 'y))
              thrust (/ (wrap-mul (wrap-mul dmg (bit-shr FRACUNIT 3)) 100) (inf 'mass)))
          ; Make fall forwards sometimes.
          (when (and (< dmg 40) (> dmg (target 'health))
                     (> (wrap-sub (target 'z) (inflictor 'z)) (* 64 FRACUNIT))
                     (!= (bit-and (p-random w) 1) 0))
            (set! ang (+ ang ANG180))
            (set! thrust (wrap-mul thrust 4)))
          (let (an (fine-index ang))
            (set! (target 'mom-x) (wrap-add (target 'mom-x) (fixed-mul thrust (finecosine an))))
            (set! (target 'mom-y) (wrap-add (target 'mom-y) (fixed-mul thrust (finesine an))))))))
    (when-some (p player)
      ; End of game hell hack.
      (when (and (= ((sector-of-mobj w target) 'special) 11) (>= dmg (target 'health)))
        (set! dmg (- (target 'health) 1)))
      ; Below certain threshold, ignore damage in god mode or with invulnerability.
      (when (and (< dmg 1000)
                 (or (!= (bit-and (p 'cheats) CF-GODMODE) 0)
                     (!= (aref (p 'powers) (as i64 PW-INVULNERABILITY)) 0)))
        (return (ok)))
      (when (!= (p 'armor-type) 0)
        (let (saved (if (= (p 'armor-type) 1) (/ dmg 3) (/ dmg 2)))
          (when (<= (p 'armor-points) saved)
            ; Armor is used up.
            (set! saved (p 'armor-points))
            (set! (p 'armor-type) 0))
          (set! (p 'armor-points) (- (p 'armor-points) saved))
          (set! dmg (- dmg saved))))
      ; Mirror mobj health here for Dave.
      (set! (p 'health) (max (- (p 'health) dmg) 0))
      (set! (p 'attacker) source)
      ; Add damage after armor and invulnerability; a telefrag does 10000.
      (set! (p 'damage-count) (min (+ (p 'damage-count) dmg) 100)))
    (set! (target 'health) (- (target 'health) dmg))
    (when (<= (target 'health) 0)
      (return (kill-mobj w source target)))
    (when (and (< (p-random w) (inf 'pain-chance)) (= (bit-and (target 'flags) MF-SKULLFLY) 0))
      ; Fight back!
      (set! (target 'flags) (bit-or (target 'flags) MF-JUSTHIT))
      (try (set-mobj-state w target (inf 'pain-state))))
    ; We're awake now.
    (set! (target 'reaction-time) 0)
    (when-some (s source)
      (when (and (or (= (target 'threshold) 0) (= (target 'type) MT-VILE))
                 (not (same? s target)) (!= (s 'type) MT-VILE))
        ; If not intent on another player, chase after this one.
        (set! (target 'target) source)
        (set! (target 'threshold) BASETHRESHOLD)
        (when (and (= (target 'state) (inf 'spawn-state)) (!= (inf 'see-state) S-NULL))
          (try (set-mobj-state w target (inf 'see-state)))))))
  (return (ok)))
