;
; P_SetupLevel, from a loaded map to a world ready for its first tic.

(ns doom.play.setup)

(import-use nucleus.vector)
(import-use doom.error)
(import-use doom.rand)
(import-use doom.mapdata)
(import-use doom.play.map)
(import-use doom.play.world)
(import-use doom.play.mobj)
(import-use doom.play.spec)

(defn level-setup (l:Level m:&Map rules:Rules players:(Vector Player) in-game:&(Vector bool)
                   random:Random pics:PicData):(Fallible &World)
  (let (w (world-new l rules players in-game random pics))
    ; Until the first P_CalcHeight; P_Ticker's menu pause waits for it.
    (set! ((player-at w (as-checked usize (rules 'console-player))) 'view-z) 1)
    (try (load-things w m))
    (try (spawn-specials w))
    (return (ok w))))
