; Nucleus port: see COPYING.
;
; The command line (Iron Doom crates/cli). clap's derive becomes `defoptions`,
; which generates the options struct and its parser from one table. A flag is
; accepted as `-iwad` (Chocolate Doom) or `--iwad` (Iron Doom).

(ns doom.cli)

(import-use nucleus.slice)
(import-use nucleus.vector)
(import-use nucleus.create)
(import-use nucleus.coll)
(import-use nucleus.string)
(import-use nucleus.strview)
(import-use nucleus.file)
(import-use nucleus.fmt)
(import-use nucleus.io)
(import-use nucleus.parse)
(import-use nucleus.math)
(import-use nucleus.node)
(import-ct nucleus.node)
(import-use doom.error)
(import-use doom.util)

(deftype Args (Vector StrView))

(defn- sv (s:CStr):StrView (return (strview-from-cstr s)))

(defn- byte (s:&StrView i:usize):ui8
  (return @(unsafe/cast &ui8 (unsafe/ptr+ (s 'data) (as-checked i64 i)))))

; Rust's char::is_whitespace on a byte read as Latin-1.
(defn- space? (c:ui8):bool
  (return (or (= c 32) (and (>= c 9) (<= c 13)) (= c 0x85) (= c 0xa0))))

(defn- has-space? (s:&StrView):bool
  (dotimes (i:usize (s 'len)) (when (space? (byte s i)) (return true)))
  (return false))

(defn- param? (s:&StrView):bool
  (return (and (> (s 'len) 0) (= (byte s 0) 45) (not (has-space? s)))))

(defn- tail (s:&StrView from:usize):StrView
  (return (strview (unsafe/cast &ui8 (unsafe/ptr+ (s 'data) (as-checked i64 from)))
                   (- (s 'len) from))))

; "--name" → "-name", so both spellings reach one table entry.
(defn- normalize (s:StrView):StrView
  (if (and (> (s 'len) 2) (= (byte &s 0) 45) (= (byte &s 1) 45))
    (return (tail &s 1))
    (return s)))

; --- response files ------------------------------------------------------------

; The file's text is kept for the life of the program: the arguments are views into it.
(defn- response-file-args (path:StrView):(Fallible Args)
  (with (f (try (file-open-read &path)))
    (let (text (try (file-read-to-string f))
          args (make Args)
          b (string-as-view &text)
          n (b 'len)
          i:usize 0)
    (while (< i n)
      ; Skip past space characters to the next argument
      (while (and (< i n) (space? (byte &b i))) (inc! i))
      (when (< i n)
        (let (j (+ i 1))
          ; A quoted argument is one argument, so it may hold spaces.
          (if (= (byte &b i) 34)
            (do (while (and (< j n) (!= (byte &b j) 34) (!= (byte &b j) 10)) (inc! j))
                (when (or (= j n) (= (byte &b j) 10))
                  (fail "Quotes unclosed in response file '" path "'\n"))
                (inc! i))
            (while (and (< j n) (not (space? (byte &b j)))) (inc! j)))
          (conj &args (strview (unsafe/cast &ui8 (unsafe/ptr+ (b 'data) (as-checked i64 i)))
                               (- j i)))
          (set! i (+ j 1)))))
    (return (ok args)))))

; "@file" → "-response file".
(defn- legacy-response-files (args:&Args):(Fallible Args)
  (let (out (make Args) a (view args) i:usize 0)
    (while (< i (count &a))
      (let (arg @(&a i))
        (if (or (= (arg 'len) 0) (!= (byte &arg 0) 64) (has-space? &arg))
          (conj &out arg)
          (do (when (= (arg 'len) 1) (fail "'@' must be followed by a response file\n"))
              (when (and (< (+ i 1) (count &a)) (not (param? (&a (+ i 1)))))
                (fail "'@' accepts only one argument\n"))
              (conj &out (sv "-response"))
              (conj &out (tail &arg 1)))))
      (inc! i))
    (return (ok out))))

; Each "-response FILE..." is replaced by the files' arguments, which are read
; in turn, so a response file may name another.
(defn- load-response-files (args:&Args):(Fallible Args)
  (let (todo (make Args) out (make Args))
    (dotimes (k:usize (count args)) (conj &todo (args k)))
    (while (> (count &todo) 0)
      (let (arg (&todo 0))
        (remove-at &todo 0)
        (if (!= arg (sv "-response"))
          (conj &out arg)
          (let (files (make Args))
            (when (= (count &todo) 0) (fail "'-response' must be followed by a response file\n"))
            (while (and (> (count &todo) 0) (let (nx (&todo 0)) (not (param? &nx))))
              (conj &files (&todo 0))
              (remove-at &todo 0))
            ; Pushed at the front, in reverse, so the files' arguments come first and in order.
            (let (k (count &files))
              (while (> k 0)
                (dec! k)
                (let (more (try (response-file-args (&files k))) m (count &more))
                  (while (> m 0)
                    (dec! m)
                    (insert &todo 0 (&more m))))))))))
    (return (ok out))))

(defn- argv-args (argc:i32 argv:ptr):Args
  (let (v (make Args) i 1)
    (while (< i argc)
      (conj &v (normalize (strview-from-cstr (aref (unsafe/cast &CStr argv) (as i64 i)))))
      (inc! i))
    (return v)))

; --- option values --------------------------------------------------------------

(defn- value-arg (a:&(Slice StrView) i:&usize flag:StrView):(Fallible StrView)
  (when (>= (+ @i 1) (count a)) (fail "a value is required for '" flag "' but none was supplied"))
  (inc! @i)
  (return (ok @(a @i))))

(defn read-option (dst:&bool a:&(Slice StrView) i:&usize flag:StrView):(Fallible void)
  (set! @dst true)
  (return (ok)))

(defn read-option (dst:&?StrView a:&(Slice StrView) i:&usize flag:StrView):(Fallible void)
  (set! @dst (some (try (value-arg a i flag))))
  (return (ok)))

(defn read-option (dst:&?i32 a:&(Slice StrView) i:&usize flag:StrView):(Fallible void)
  (let (s (try (value-arg a i flag)))
    (match (parse i32 &s)
      ((ok n) (set! @dst (some n)))
      ((err e) (fail "invalid value '" s "' for '" flag "'"))))
  (return (ok)))

; -framedump TICS DIR: write the frames of the listed tics (comma-separated) to
; DIR, then exit. Tic 1 is the first, still in setup, as reference/iron-doom.patch counts.
(defstruct Framedump tics:(Vector i32) dir:StrView)

(defn read-option (dst:&?Framedump a:&(Slice StrView) i:&usize flag:StrView):(Fallible void)
  (let (list (try (value-arg a i flag))
        tics (make (Vector i32))
        b (unsafe/cast &ui8 (list 'data))
        start:usize 0
        k:usize 0)
    (while (<= k (list 'len))
      (when (or (= k (list 'len)) (= @(unsafe/cast &ui8 (unsafe/ptr+ b (as-checked i64 k))) 44))
        (let (part (strview (unsafe/cast &ui8 (unsafe/ptr+ b (as-checked i64 start))) (- k start)))
          (match (parse i32 &part)
            ((ok n) (conj &tics n))
            ((err e) (fail "invalid tic '" part "' for '" flag "'"))))
        (set! start (+ k 1)))
      (inc! k))
    (set! @dst (some (Framedump tics (try (value-arg a i flag)))))
    (return (ok))))

(defn last-tic (fd:&Framedump):i32
  (let (m 0 v (view (ref fd 'tics)))
    (dotimes (i:usize (count &v)) (set! m (max m @(&v i))))
    (return m)))

(defn dump-tic? (fd:&Framedump tic:i32):bool
  (let (v (view (ref fd 'tics)))
    (dotimes (i:usize (count &v)) (when (= @(&v i) tic) (return true)))
    (return false)))

; --- the table -------------------------------------------------------------------

; (defoptions T (field "-flag" "VALUE" "help") …) generates `parse-options`,
; filling a T from the arguments, and `print-usage`. Each row's field must be
; one of T's, and its type picks the `read-option` that reads it. T is written
; out, since a macro-defined type can't appear in a signature (ISSUE-011).
(defmacro defoptions (nm :rest opts)
  (let (fs (struct-fields nm) tests (node-list-new 0) helps (node-list-new 0))
    (dotimes (k (ast-len opts))
      (let (o (ast-at opts k) found false)
        (dotimes (j (ast-len fs))
          (when (= (ast-at (ast-at fs j) 0) (ast-at o 0)) (set! found true)))
        (when (not found) (macro-error o "defoptions: no such field in the options struct"))
        (node-push tests `(= arg (strview-from-cstr ~(ast-at o 1))))
        (node-push tests `(try (read-option (ref out '~(ast-at o 0)) a &i arg)))
        (node-push helps `(println "  " ~(ast-at o 1) " <" ~(ast-at o 2) ">\n          "
                                   ~(ast-at o 3)))))
    `(do (defn parse-options ((out (ref ~nm)) (a (ref (Slice StrView)))):(Fallible void)
           (let (i:usize 0)
             ; A template's `count` must name one namespace's methods (ISSUE-010).
             (while (< i (nucleus.slice/count a))
               (let (arg @(a i))
                 (cond ~@tests
                       true (fail "unexpected argument '" arg "' found")))
               (inc! i)))
           (return (ok)))
         (defn print-usage ((o (ref ~nm))):void
           (println "Usage: nuc-iron-doom [OPTIONS]\n\nOptions:")
           ~@helps
           (println "  -response <FILES>...\n          "
                    "Load extra command line arguments from the given response file")))))

(defstruct CommandLine iwad:?StrView framedump:?Framedump iron-render:bool)

(defoptions CommandLine
  (iwad "-iwad" "FILE" "Specify an IWAD file to use")
  (framedump "-framedump" "TICS DIR" "Write the frames of the listed tics (1,2,…) to DIR as PPMs, then exit")
  (iron-render "-ironrender" "" "Draw levels with Iron Doom's renderer (walls and sky only), for comparing frames with it"))

(defn command-line-from (args:&Args):(Fallible CommandLine)
  (let (a1 (try (legacy-response-files args))
        a2 (try (load-response-files &a1))
        s (view &a2)
        cl (CommandLine none none false))
    (try (parse-options &cl &s))
    (return (ok cl))))

(defn command-line (argc:i32 argv:ptr):(Fallible CommandLine)
  (let (args (argv-args argc argv))
    (return (command-line-from &args))))
