;
; The front-to-back BSP walk. Each subsector's segs are clipped against the
; columns solid walls already cover; a node's far side is skipped when its
; bounding box is hidden.

(ns doom.render.bsp)

(import-use nucleus.slice)
(import-use nucleus.vector)
(import-use nucleus.coll)
(import-use doom.error)
(import-use doom.util)
(import-use doom.fixed)
(import-use doom.play.map)
(import-use doom.render.state)
(import-use doom.render.plane)
(import-use doom.render.segs)

(defn- solid (r:&Renderer i:usize):ClipRange (return ((ref r 'solid-segs) i)))
(defn- set-solid (r:&Renderer i:usize c:ClipRange):void (set (ref r 'solid-segs) i c))

(defn clear-clip-segs (r:&Renderer):void
  (set-solid r 0 (ClipRange -0x7fffffff -1))
  (set-solid r 1 (ClipRange (r 'view-width) 0x7fffffff))
  (set! (r 'new-end) 2))

; R_ClipSolidWallSegment: draw the uncovered parts of columns first..last,
; then mark them all covered.
(defn- clip-solid (r:&Renderer sc:&Scene first:i32 last:i32):(Fallible void)
  (let (start:usize 0)
    (while (< ((solid r start) 'last) (- first 1)) (inc! start))
    (when (< first ((solid r start) 'first))
      (when (< last (- ((solid r start) 'first) 1))
        ; Entirely visible: insert a new range before `start`.
        (try (store-wall-range r sc first last))
        (let (next (r 'new-end))
          (set! (r 'new-end) (+ next 1))
          (while (!= next start)
            (set-solid r next (solid r (- next 1)))
            (set! next (- next 1)))
          (set-solid r next (ClipRange first last))
          (return (ok))))
      (try (store-wall-range r sc first (- ((solid r start) 'first) 1)))
      (set-solid r start (ClipRange first ((solid r start) 'last))))
    (when (<= last ((solid r start) 'last)) (return (ok)))
    (let (next start crunch false)
      (while (and (not crunch) (>= last (- ((solid r (+ next 1)) 'first) 1)))
        (try (store-wall-range r sc (+ ((solid r next) 'last) 1) (- ((solid r (+ next 1)) 'first) 1)))
        (inc! next)
        (when (<= last ((solid r next) 'last))
          (set-solid r start (ClipRange ((solid r start) 'first) ((solid r next) 'last)))
          (set! crunch true)))
      (when (not crunch)
        (try (store-wall-range r sc (+ ((solid r next) 'last) 1) last))
        (set-solid r start (ClipRange ((solid r start) 'first) last)))
      ; Remove the ranges the new one swallowed. Vanilla's loop also copies
      ; the stale entry past the end, which the overflow check counts.
      (when (!= next start)
        (let (to start from next)
          (while (!= from (r 'new-end))
            (inc! from)
            (inc! to)
            (set-solid r to (solid r from)))
          (set! (r 'new-end) (+ to 1))))))
  (return (ok)))

; R_ClipPassWallSegment: draw the uncovered parts, covering nothing.
(defn- clip-pass (r:&Renderer sc:&Scene first:i32 last:i32):(Fallible void)
  (let (start:usize 0)
    (while (< ((solid r start) 'last) (- first 1)) (inc! start))
    (when (< first ((solid r start) 'first))
      (when (< last (- ((solid r start) 'first) 1))
        (try (store-wall-range r sc first last))
        (return (ok)))
      (try (store-wall-range r sc first (- ((solid r start) 'first) 1))))
    (when (<= last ((solid r start) 'last)) (return (ok)))
    (while (>= last (- ((solid r (+ start 1)) 'first) 1))
      (try (store-wall-range r sc (+ ((solid r start) 'last) 1) (- ((solid r (+ start 1)) 'first) 1)))
      (inc! start)
      (when (<= last ((solid r start) 'last)) (return (ok))))
    (try (store-wall-range r sc (+ ((solid r start) 'last) 1) last)))
  (return (ok)))

; Clip a pair of view-relative angles to the field of view; false when the
; span between them is outside it.
(defn- clip-angles (r:&Renderer a1:&Angle a2:&Angle span:Angle):bool
  (let (ca (r 'clip-angle) t (+ @a1 ca))
    (when (> t (* 2 ca))
      (when (>= (- t (* 2 ca)) span) (return false))
      (set! @a1 ca))
    (set! t (- ca @a2))
    (when (> t (* 2 ca))
      (when (>= (- t (* 2 ca)) span) (return false))
      (set! @a2 (- 0 ca)))
    (return true)))

(defn- angle-to-x (r:&Renderer a:Angle):i32
  (return (view-angle-to-x r (as usize (bit-shr (+ a ANG90) ANGLETOFINESHIFT)))))

; R_AddLine: a seg facing the eye and inside the view goes to the clippers.
(defn- add-line (r:&Renderer sc:&Scene seg-index:usize):(Fallible void)
  (let (l (sc 'level) s (seg-at l seg-index)
        v1 (vertex-at l (s 'v1)) v2 (vertex-at l (s 'v2))
        angle1 (point-to-angle r (v1 'x) (v1 'y))
        angle2 (point-to-angle r (v2 'x) (v2 'y))
        span (- angle1 angle2))
    (set! (r 'cur-line) seg-index)
    ; Back side, or the eye is in line with it.
    (when (>= span ANG180) (return (ok)))
    (set! (r 'rw-angle1) angle1)
    (let (a1 (- angle1 (r 'view-angle)) a2 (- angle2 (r 'view-angle)))
      (when (not (clip-angles r &a1 &a2 span)) (return (ok)))
      (let (x1 (angle-to-x r a1) x2 (angle-to-x r a2))
        (when (= x1 x2) (return (ok)))
        (set! (r 'back-sector) (s 'back-sector))
        (match (s 'back-sector)
          ((none) (try (clip-solid r sc x1 (- x2 1))))
          ((some bi)
           (let (front (sector-at l (r 'front-sector)) back (sector-at l bi))
             (cond (or (<= (back 'ceiling-height) (front 'floor-height))
                       (>= (back 'floor-height) (front 'ceiling-height)))
                   (try (clip-solid r sc x1 (- x2 1)))
                   (or (!= (back 'ceiling-height) (front 'ceiling-height))
                       (!= (back 'floor-height) (front 'floor-height)))
                   (try (clip-pass r sc x1 (- x2 1)))
                   ; Nothing to see: same planes and light, no middle texture.
                   (and (= (back 'ceiling-pic) (front 'ceiling-pic))
                        (= (back 'floor-pic) (front 'floor-pic))
                        (= (back 'light-level) (front 'light-level))
                        (= ((side-at l (s 'side)) 'mid-texture) 0))
                   0
                   true (try (clip-pass r sc x1 (- x2 1))))))))))
  (return (ok)))

(defn- bbox-coord (b:&BBox i:i32):Fixed
  (cond (= i BOXTOP) (return (b 'top))
        (= i BOXBOTTOM) (return (b 'bottom))
        (= i BOXLEFT) (return (b 'left))
        true (return (b 'right))))

; Which box corners bound the view of a box, by where the eye is around it.
(defconst CHECKCOORD (array i32
  3 0 2 1  3 0 2 0  3 1 2 0  0 0 0 0
  2 0 2 1  0 0 0 0  3 1 3 0  0 0 0 0
  2 0 3 1  2 1 3 1  2 1 3 0  0 0 0 0))

; R_CheckBBox: could any part of the box be visible?
(defn- check-bbox (r:&Renderer b:&BBox):bool
  (let (vx (r 'view-x) vy (r 'view-y)
        boxx (cond (<= vx (b 'left)) 0 (< vx (b 'right)) 1 true 2)
        boxy (cond (>= vy (b 'top)) 0 (> vy (b 'bottom)) 1 true 2)
        boxpos (+ (bit-shl boxy 2) boxx))
    (when (= boxpos 5) (return true))
    (let (k (as i64 (* boxpos 4))
          x1 (bbox-coord b (aref CHECKCOORD k)) y1 (bbox-coord b (aref CHECKCOORD (+ k 1)))
          x2 (bbox-coord b (aref CHECKCOORD (+ k 2))) y2 (bbox-coord b (aref CHECKCOORD (+ k 3)))
          a1 (- (point-to-angle r x1 y1) (r 'view-angle))
          a2 (- (point-to-angle r x2 y2) (r 'view-angle))
          span (- a1 a2))
      ; The eye is inside the box.
      (when (>= span ANG180) (return true))
      (when (not (clip-angles r &a1 &a2 span)) (return false))
      (let (sx1 (angle-to-x r a1) sx2 (angle-to-x r a2) start:usize 0)
        (when (= sx1 sx2) (return false))
        (set! sx2 (- sx2 1))
        (while (< ((solid r start) 'last) sx2) (inc! start))
        (return (not (and (>= sx1 ((solid r start) 'first)) (<= sx2 ((solid r start) 'last)))))))))

; Hands each subsector's sector to the sprite pass before its segs are drawn.
; ISSUE-018: only the canonical one-form spelling works in deftype.
(deftype AddSprites ((fn void) (&Renderer &Scene usize)))

(defn- subsector (r:&Renderer sc:&Scene num:usize add-sprites:AddSprites):(Fallible void)
  (let (l (sc 'level) ss (sub-sector-at l num) sec-i (ss 'sector) front (sector-at l sec-i))
    (set! (r 'front-sector) sec-i)
    (set! (r 'floor-plane)
          (if (< (front 'floor-height) (r 'view-z))
            (some (try (find-plane r sc (front 'floor-height) (front 'floor-pic) (front 'light-level))))
            none))
    (set! (r 'ceiling-plane)
          (if (or (> (front 'ceiling-height) (r 'view-z)) (= (front 'ceiling-pic) (l 'sky-flat)))
            (some (try (find-plane r sc (front 'ceiling-height) (front 'ceiling-pic) (front 'light-level))))
            none))
    (add-sprites r sc sec-i)
    (dotimes (k:usize (ss 'num-lines))
      (try (add-line r sc (+ (ss 'first-line) k))))
    (when (> (r 'new-end) 32)
      (fail "R_Subsector: solidsegs overflow (vanilla may crash here)")))
  (return (ok)))

(defn render-bsp-node (r:&Renderer sc:&Scene bspnum:i32 add-sprites:AddSprites):(Fallible void)
  (when (!= (bit-and bspnum NF-SUBSECTOR) 0)
    (try (subsector r sc (if (= bspnum -1) 0 (as usize (bit-and bspnum (bit-not NF-SUBSECTOR)))) add-sprites))
    (return (ok)))
  (let (node (node-at (sc 'level) (as usize bspnum))
        side (point-on-side (r 'view-x) (r 'view-y) node))
    (try (render-bsp-node r sc (aref (node 'children) (as i64 side)) add-sprites))
    (when (let (b:BBox (aref (node 'bbox) (as i64 (bit-xor side 1)))) (check-bbox r &b))
      (try (render-bsp-node r sc (aref (node 'children) (as i64 (bit-xor side 1))) add-sprites))))
  (return (ok)))
