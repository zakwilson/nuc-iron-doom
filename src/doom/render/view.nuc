;
; One frame of the 3D view: walls and plane marks from the BSP walk, then the
; planes, then sprites and masked walls.

(ns doom.render.view)

(import-use nucleus.vector)
(import-use nucleus.coll)
(import-use doom.error)
(import-use doom.fixed)
(import-use doom.play.map)
(import-use doom.render.state)
(import-use doom.render.plane)
(import-use doom.render.bsp)
(import-use doom.render.things)

; Where the eye is: R_SetupFrame's inputs from the player.
(defstruct Eye x:Fixed y:Fixed z:Fixed angle:Angle extra-light:i32 fixed-colormap:i32)

(defn- setup-frame (r:&Renderer e:&Eye):void
  (set! (r 'view-x) (e 'x))
  (set! (r 'view-y) (e 'y))
  (set! (r 'view-z) (e 'z))
  (set! (r 'view-angle) (e 'angle))
  (set! (r 'extra-light) (e 'extra-light))
  (set! (r 'view-sin) (angle-sin (e 'angle)))
  (set! (r 'view-cos) (angle-cos (e 'angle)))
  (set! (r 'fixed-colormap) (e 'fixed-colormap)))

(defn render-player-view (r:&Renderer sc:&Scene e:&Eye):(Fallible void)
  (setup-frame r e)
  (clear-clip-segs r)
  (clear! (ref r 'draw-segs))
  (clear-planes r)
  (clear-sprites r sc)
  (let (n (count (ref (sc 'level) 'nodes)))
    ; A map of one subsector has no nodes; -1 is that subsector.
    (try (render-bsp-node r sc (if (= n 0) -1 (unsafe/cast i32 (- n 1))))))
  (draw-planes r sc)
  (draw-masked r sc)
  (return (ok)))
