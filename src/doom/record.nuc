; Nucleus port: see COPYING.
;
; Iron Doom has one parser module per map lump, each slicing fixed offsets out
; of a chunk by hand. `derive-record` generates a record's on-disk size and
; reader from its struct, so the layout is written once.

(ns doom.record)

(import-use nucleus.slice)
(import-use nucleus.vector)
(import-use nucleus.create)
(import-use nucleus.coll)
(import-use nucleus.node)
(import-ct nucleus.node)
(import-use doom.bytes)

(defn read-field (dst:&i16 b:&Bytes o:&usize):void
  (set! @dst (le-i16 b @o))
  (set! @o (+ @o 2)))

(defn read-field (dst:&Name b:&Bytes o:&usize):void
  (set! @dst (name-at b @o))
  (set! @o (+ @o 8)))

(defn disk-size (x:&i16):usize (return 2))
(defn disk-size (x:&Name):usize (return 8))

(defprotocol Record
  (record-size (x:&Self):usize)
  (read-record (out:&Self b:&Bytes off:usize):void))

; (derive-record T): T's fields, in order, are its on-disk layout. The struct is
; written out rather than generated, because a macro-defined type can't appear
; in another function's signature (ISSUE-011).
(defmacro derive-record (rec)
  (let (fs (struct-fields rec) sizes (node-list-new 0) reads (node-list-new 0))
    (dotimes (i (ast-len fs))
      (let (f (ast-at (ast-at fs i) 0))
        (node-push sizes `(set! n (+ n (disk-size (ref x '~f)))))
        (node-push reads `(read-field (ref out '~f) b &o))))
    ; List-form parameters: `out:&~rec` is one atom the template can't reach (ISSUE-002).
    `(do (defn record-size ((x (ref ~rec))):usize
           (let (n:usize 0) ~@sizes n))
         (defn read-record ((out (ref ~rec)) b:&Bytes off:usize):void
           (let (o off) ~@reads))
         (extend ~rec Record))))

; Every whole record in `b`; a trailing partial one is ignored, as chunks_exact does.
(defn read-records (b:&Bytes :where (Record T)):(Vector T)
  (let (v (make (Vector T))
        tmp:&T (alloca T)
        n (/ (count b) (record-size tmp))
        i:usize 0)
    (while (< i n)
      (read-record tmp b (* i (record-size tmp)))
      (conj &v @tmp)
      (inc! i))
    (return v)))
