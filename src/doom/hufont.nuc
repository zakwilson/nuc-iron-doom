;
; The heads-up font (STCFN033 to STCFN095, '!' to '_'), which the HUD, the
; menus and the finale's text all draw with.

(ns doom.hufont)

(import-use nucleus.vector)
(import-use nucleus.slice)
(import-use nucleus.coll)
(import-use nucleus.create)
(import-use nucleus.string)
(import-use nucleus.strview)
(import-use nucleus.fmt)
(import-use doom.error)
(import-use doom.util)
(import-use doom.bytes)
(import-use doom.wad)
(import-use doom.buffer)
(import-use doom.graphics)

(defconst HU-FONTSTART 33)
(defconst HU-FONTEND 95)
(defconst HU-FONTSIZE 63)

(defstruct HuFont patches:(Vector Patch))

(defn hu-font-load (w:&Wad):(Fallible HuFont)
  (let (v (make (Vector Patch)) c HU-FONTSTART)
    (while (<= c HU-FONTEND)
      (let (n (str "STCFN" (if (< c 100) "0" "") c))
        (conj &v (try (patch-parse (ref (try (lump-named w (name (string-as-view &n)))) 'data)))))
      (set! c (+ c 1)))
    (return (ok (HuFont v)))))

; The upper-cased character's index in the font, or -1 for none (a space).
(defn font-index (c:i32):i32
  (let (u (if (and (>= c 97) (<= c 122)) (- c 32) c) i (- u HU-FONTSTART))
    (return (if (or (< i 0) (>= i HU-FONTSIZE)) -1 i))))

(defn font-patch (f:&HuFont i:i32):&Patch
  (let (s (view (ref f 'patches))) (return (&s (as-checked usize i)))))

