; Unit tests: `nucleus test` (build.edn :tests).

(import-use nucleus.error)
(import-use nucleus.strview)
(import-use nucleus.string)
(import-use nucleus.io)
(import-use nucleus.test)
(import-use tests.bytes)
(import-use tests.wad)
(import-use tests.mapdata)

(defn main (argc:i32 argv:ptr):int
  (return (as int (test-main argc argv))))
