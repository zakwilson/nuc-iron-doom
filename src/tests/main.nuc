(import-use tests.graphics)
(import-use tests.rand)
(import-use tests.cli)
(import-use tests.iwad)
(import-use tests.level)
(import-use tests.render)
(import-use tests.session)
(import-use tests.menu)
(import-use tests.cheats)
(import-use tests.automap)
(import-use tests.sound)

(defn main (argc:i32 argv:ptr):int
  (return (as int (test-main argc argv))))
