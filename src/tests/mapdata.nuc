(ns tests.mapdata)

(import-use nucleus.test)
(import-use nucleus.strview)
(import-use nucleus.hashmap)
(import-use nucleus.vector)
(import-use nucleus.coll)
(import-use doom.error)
(import-use doom.bytes)
(import-use doom.wad)
(import-use doom.mapdata)

(deftest shareware-maps
  (match (wad-open (strview-from-cstr "/usr/share/games/doom/doom1.wad"))
    ((err e) (skip! "no shareware IWAD: " (failure-text &e)))
    ((ok w)
     (let (maps (maps-parse &w))
       (try (check-eq-int (as i64 (count &maps)) 9 "shareware has E1M1..E1M9"))
       (match (get &maps (map-name 1 1))
         ((none) (try (check false "E1M1 parsed")))
         ((some m)
          (try (check-eq-int (as i64 (count (ref m 'vertexes))) 467 "E1M1 vertexes"))
          (try (check-eq-int (as i64 (count (ref m 'things))) 138 "E1M1 things"))
          (let (t0 ((ref m 'things) 0))
            (try (check-eq-int (as i64 (t0 'x)) 1056 "first thing x"))
            (try (check-eq-int (as i64 (t0 'thing-type)) 1 "player 1 start")))
          (let (s0 ((ref m 'sides) 0))
            (try (check (= (s0 'middle-texture) (name "DOOR3")) "first side texture")))))))))
