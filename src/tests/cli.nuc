(ns tests.cli)

(import-use nucleus.test)
(import-use nucleus.strview)
(import-use nucleus.string)
(import-use nucleus.vector)
(import-use nucleus.create)
(import-use nucleus.coll)
(import-use nucleus.file)
(import-use doom.error)
(import-use doom.cli)

(deftest options-both-spellings
  (let (a (make Args))
    (conj &a (strview-from-cstr "-iwad"))
    (conj &a (strview-from-cstr "doom1.wad"))
    (conj &a (strview-from-cstr "-framedump"))
    (conj &a (strview-from-cstr "2,70"))
    (conj &a (strview-from-cstr "out"))
    (match (command-line-from &a)
      ((err e) (try (check false (failure-text &e))))
      ((ok cl)
       (try (check-eq (unwrap-or (cl 'iwad) (strview-from-cstr "")) "doom1.wad"))
       (match (cl 'framedump)
         ((none) (try (check false "framedump parsed")))
         ((some fd)
          (try (check-eq-int (as i64 (last-tic &fd)) 70 "framedump last tic"))
          (try (check (dump-tic? &fd 2) "framedump tic 2"))
          (try (check-eq (fd 'dir) "out"))))))))

(deftest unknown-option-is-an-error
  (let (a (make Args))
    (conj &a (strview-from-cstr "-bogus"))
    (match (command-line-from &a)
      ((ok cl) (try (check false "-bogus refused")))
      ((err e) (try (check-contains (failure-text &e) "unexpected argument"))))))

(deftest response-file-arguments
  (with (f (try (file-create &(strview-from-cstr "build/test.rsp"))))
    (try (write-str f (strview-from-cstr "  -iwad \"my doom.wad\"\n"))))
  (let (a (make Args))
    (conj &a (strview-from-cstr "@build/test.rsp"))
    (match (command-line-from &a)
      ((err e) (try (check false (failure-text &e))))
      ((ok cl) (try (check-eq (unwrap-or (cl 'iwad) (strview-from-cstr "")) "my doom.wad"))))))
