(ns tests.level)

(import-use nucleus.test)
(import-use nucleus.strview)
(import-use nucleus.vector)
(import-use nucleus.create)
(import-use nucleus.coll)
(import-use doom.error)
(import-use doom.assets)
(import-use doom.mapdata)
(import-use doom.level)
(import-use doom.vec2)

(deftest e1m1-level
  (match (assets-load (strview-from-cstr "/usr/share/games/doom/doom1.wad"))
    ((err e) (skip! "no shareware IWAD: " (failure-text &e)))
    ((ok a)
     (match (find-map &a 1 1)
       ((none) (try (check false "E1M1 found")))
       ((some m)
        (match (level-load &m (ref a 'flats) (ref a 'textures))
          ((err e) (try (check false (failure-text &e))))
          ((ok l)
           (try (check-eq-int (as i64 (count (ref l 'segments))) (as i64 (count (ref m 'segments))) "segments"))
           ; Things 2 to 4 are left out.
           (try (check-eq-int (as i64 (count (ref l 'objects))) 135 "map objects"))
           (let (p (player &l))
             (try (check (= (p 'pos) (Vec2 1056.0 -3616.0)) "player start"))
             (try (check (= ((p 'dir) 'y) 1.0) "player faces north")))
           (let (order (make (Vector usize)))
             (sub-sectors-from &l ((player &l) 'pos) &order)
             (try (check-eq-int (as i64 (count &order)) (as i64 (count (ref l 'sub-sectors)))
                                "the walk visits every subsector once"))))))))))
