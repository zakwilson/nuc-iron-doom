(ns tests.automap)

; The automap opened on E1M1 with iddt typed twice (every line and thing),
; drawn to build/tic09996.ppm for checking by eye.

(import-use nucleus.test)
(import-use nucleus.strview)
(import-use nucleus.slice)
(import-use doom.error)
(import-use doom.util)
(import-use doom.assets)
(import-use doom.buffer)
(import-use doom.framedump)
(import-use doom.input)
(import-use doom.hufont)
(import-use doom.play.defs)
(import-use doom.play.world)
(import-use doom.session)
(import-use doom.automap)

(defn- key (am:&Automap w:&World a:&Assets k:i32):(Fallible bool)
  (let (ev (Event EV-KEYDOWN k (if (< k 127) k 0)))
    (return (automap-responder am w (ref a 'wad) &ev))))

(deftest automap-draws-e1m1
  (match (assets-load (strview-from-cstr "/usr/share/games/doom/doom1.wad"))
    ((err e) (skip! "no shareware IWAD: " (failure-text &e)))
    ((ok a)
     (let (s (try (session-new &a (game-mode &a))) am (automap-new))
       (try (session-init-new s &a SK-MEDIUM 1 1))
       (let (w (session-world s))
         (try (check (not (try (key &am w &a 105))) "a closed automap leaves keys alone"))
         (try (check (try (key &am w &a KEY-TAB)) "Tab opens it"))
         (try (check (am 'active) "open"))
         (dotimes (i:usize 2)
           (try (key &am w &a 105)) (try (key &am w &a 100))
           (try (key &am w &a 100)) (try (key &am w &a 116)))
         (try (check (= (am 'cheating) 2) "iddt twice: lines and things"))
         (try (key &am w &a 109))
         (automap-ticker &am w)
         (let (screen (array2d (as usize 320) (as usize 200) (as ui8 7))
               ps (view (ref a 'palettes)))
           (try (automap-drawer &am w &screen))
           (let (red 0 cs (cells &screen))
             (dotimes (i:usize (* 320 168))
               (when (= @(&cs i) (as ui8 176)) (set! red (+ red 1))))
             (try (check (> red 500) "walls drawn in red")))
           (try (framedump-write (strview-from-cstr "build") 9996 &screen (&ps 0) 0)))
         (try (check (try (key &am w &a KEY-TAB)) "Tab closes it"))
         (try (check (not (am 'active)) "closed")))))))
