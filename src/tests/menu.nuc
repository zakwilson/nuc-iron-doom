(ns tests.menu)

; The menus driven by key events. The skill menu is drawn to
; build/tic09997.ppm and the save menu to build/tic09996.ppm, for checking by
; eye.

(import-use nucleus.test)
(import-use nucleus.strview)
(import-use nucleus.vector)
(import-use nucleus.slice)
(import-use nucleus.coll)
(import-use nucleus.string)
(import-use doom.error)
(import-use doom.util)
(import-use doom.assets)
(import-use doom.buffer)
(import-use doom.graphics)
(import-use doom.framedump)
(import-use doom.hufont)
(import-use doom.input)
(import-use doom.menu)

(defn- press (m:&MenuState key:i32):bool
  (let (ev (Event EV-KEYDOWN key (if (< key 127) key 0)))
    (return (menu-responder m &ev 0 false))))

(deftest new-game-through-the-menus
  (match (assets-load (strview-from-cstr "/usr/share/games/doom/doom1.wad"))
    ((err e) (skip! "no shareware IWAD: " (failure-text &e)))
    ((ok a)
     (let (m (menu-new false true false))
       (try (check (not (press &m KEY-UPARROW)) "a closed menu leaves arrows to the game"))
       (try (check (press &m KEY-ESCAPE) "Escape opens it"))
       (try (check (m 'active) "open"))
       (press &m KEY-ENTER)
       (press &m KEY-ENTER)
       (let (font (try (hu-font-load (ref a 'wad)))
             screen (array2d (as usize 320) (as usize 200) (as ui8 0))
             ps (view (ref a 'palettes)))
         (try (draw-patch &screen 0 0 (ref a 'title)))
         (try (menu-drawer &m (ref a 'wad) &font &screen))
         (try (framedump-write (strview-from-cstr "build") 9997 &screen (&ps 0) 0)))
       ; Hurt Me Plenty is the skill menu's default.
       (press &m KEY-ENTER)
       (try (check (not (m 'active)) "a skill closes the menu"))
       (let (found false rs (view (ref m 'requests)))
         (dotimes (i:usize (count &rs))
           (match @(&rs i)
             ((new-game skill ep) (try (check (and (= skill 2) (= ep 1)) "skill 2, episode 1"))
                                  (set! found true))
             ((end-game) 0) ((quit) 0) ((player-message t) 0) ((view-size) 0) ((sound n) 0)
             ((read-saves) 0) ((load-game k) 0) ((save-game k) 0)))
         (try (check found "a new game was asked for")))))))

(deftest shareware-episode-two-refused
  (let (m (menu-new false true false))
    (press &m KEY-ESCAPE)
    (press &m KEY-ENTER)
    (press &m KEY-DOWNARROW)
    (press &m KEY-ENTER)
    (try (check (m 'to-print) "the shareware message"))
    (press &m 32)
    (try (check (not (m 'to-print)) "a key dismisses it"))))

; The last request of each kind the menu made: read-saves, load or save.
(defstruct Asked reads:i32 load:i32 save:i32)

(defn- asked (m:&MenuState):Asked
  (let (out (Asked 0 -1 -1) rs (view (ref m 'requests)))
    (dotimes (i:usize (count &rs))
      (match @(&rs i)
        ((read-saves) (set! (out 'reads) (+ (out 'reads) 1)))
        ((load-game k) (set! (out 'load) k))
        ((save-game k) (set! (out 'save) k))
        ((new-game skill ep) 0) ((end-game) 0) ((quit) 0) ((player-message t) 0)
        ((view-size) 0) ((sound n) 0)))
    (clear! (ref m 'requests))
    (return out)))

(deftest saving-through-the-menus
  (match (assets-load (strview-from-cstr "/usr/share/games/doom/doom1.wad"))
    ((err e) (skip! "no shareware IWAD: " (failure-text &e)))
    ((ok a)
     (let (m (menu-new false true false) font (try (hu-font-load (ref a 'wad))))
       (menu-set-font &m &font)
       (press &m (+ KEY-F1 1))
       (try (check (m 'to-print) "no save outside a game"))
       (press &m 32)
       (set! (m 'user-game) true)
       (set! (m 'in-level) true)
       ; F6 with no quicksave slot yet: the save menu, to pick one.
       (press &m (+ KEY-F1 5))
       (try (check (= ((asked &m) 'reads) 1) "the slots are read"))
       (menu-set-slot &m 1 (some (strview-from-cstr "OLD GAME")))
       (press &m KEY-DOWNARROW)
       (press &m KEY-ENTER)
       (try (check (m 'save-entry) "typing a description"))
       (try (check (= (string-as-view (slot-text-of &m 1)) (strview-from-cstr "OLD GAME")) "over the old one"))
       (dotimes (k:usize 4) (press &m KEY-BACKSPACE))
       (press &m 120)
       (let (screen (array2d (as usize 320) (as usize 200) (as ui8 0)) ps (view (ref a 'palettes)))
         (try (draw-patch &screen 0 0 (ref a 'title)))
         (try (menu-drawer &m (ref a 'wad) &font &screen))
         (try (framedump-write (strview-from-cstr "build") 9996 &screen (&ps 0) 0)))
       (press &m KEY-ENTER)
       (try (check (= (string-as-view (slot-text-of &m 1)) (strview-from-cstr "OLD X")) "typed upper-case"))
       (try (check (= ((asked &m) 'save) 1) "saved to slot 2"))
       (try (check (= (m 'quick-save-slot) 1) "the quicksave slot"))
       ; F9 asks, and y loads the quicksave slot.
       (press &m (+ KEY-F1 8))
       (try (check (m 'to-print) "quickload asks"))
       (press &m 121)
       (try (check (= ((asked &m) 'load) 1) "loads slot 2"))
       ; An empty slot can't be loaded.
       (press &m (+ KEY-F1 2))
       (menu-set-slot &m 0 none)
       (press &m KEY-ENTER)
       (try (check (= ((asked &m) 'load) -1) "nothing loads from an empty slot"))))))
