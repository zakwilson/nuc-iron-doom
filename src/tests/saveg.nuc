(ns tests.saveg)

; Savegames: demo3 saved and loaded part way through plays on with the same
; tic hashes as an uninterrupted run, and a save survives a second round trip
; byte for byte.

(import-use nucleus.test)
(import-use nucleus.strview)
(import-use nucleus.string)
(import-use nucleus.vector)
(import-use nucleus.slice)
(import-use nucleus.coll)
(import-use nucleus.create)
(import-use nucleus.file)
(import-use doom.config)
(import-use nucleus.hashmap)
(import-use doom.error)
(import-use doom.util)
(import-use doom.assets)
(import-use doom.play.defs)
(import-use doom.play.world)
(import-use doom.play.saveg)
(import-use doom.session)

(defn- same-bytes (a:&(Vector ui8) b:&(Vector ui8)):bool
  (when (!= (count a) (count b)) (return false))
  (let (x (view a) y (view b))
    (dotimes (i:usize (count &x))
      (when (!= @(&x i) @(&y i)) (return false))))
  (return true))

(deftest demo3-survives-a-load
  (match (assets-load (strview-from-cstr "/usr/share/games/doom/doom1.wad"))
    ((err e) (skip! "no shareware IWAD: " (failure-text &e)))
    ((ok a)
     (let (s (try (session-new &a (game-mode &a))))
       (set! (s 'tichash) (some (make String)))
       (try (session-play-demo s &a (strview-from-cstr "demo3")))
       (while (< (s 'gametic) 1000) (try (session-tic s &a (ticcmd-zero))))
       (let (saved (try (session-save s (strview-from-cstr "demo3 at 1000"))))
         ; For a headless -loadgame run: -config build/savetest/config.edn.
         (try (make-parent-dirs (strview-from-cstr "build/savetest/doomsav0.nsg")))
         (with (f (try (file-create &(strview-from-cstr "build/savetest/doomsav0.nsg"))))
           (try (file-write-bytes f (unsafe/cast &ui8 ((view &saved) 'data)) (count &saved))))
         (match (session-load s &a (view &saved))
           ((ok) 0)
           ((err e) (fail! "load: " (failure-text &e))))
         (let (again (try (session-save s (strview-from-cstr "demo3 at 1000"))))
           (try (check (same-bytes &saved &again) "a loaded save saves the same bytes"))
           (drop &again))
         (let (info (try (save-info (view &saved) (s 'rules))))
           (try (check (= (string-as-view (ref info 'description)) (strview-from-cstr "demo3 at 1000"))
                       "the description")))
         (drop &saved))
       (while (not (s 'demo-ended)) (try (session-tic s &a (ticcmd-zero))))
       (try (check (= (s 'gametic) 2134) "2134 gametics"))
       ; Every tic's hash is the uninterrupted run's.
       (let (u (try (session-new &a (game-mode &a))))
         (set! (u 'tichash) (some (make String)))
         (try (session-play-demo u &a (strview-from-cstr "demo3")))
         (while (not (u 'demo-ended)) (try (session-tic u &a (ticcmd-zero))))
         (when-some (t (s 'tichash))
           (when-some (t2 (u 'tichash))
             (try (check (= (string-as-view &t) (string-as-view &t2)) "the same tic hashes"))))
         (when-some (t (s 'tichash))
           (let (v (string-as-view &t))
             (try (check (strview-has-suffix v (strview-from-cstr "2133 107 207 8f22bba2 254 0/68/2/20/9/0\n"))
                         "demo3's last tic")))))))))

(deftest a-short-save-is-refused
  (match (assets-load (strview-from-cstr "/usr/share/games/doom/doom1.wad"))
    ((err e) (skip! "no shareware IWAD: " (failure-text &e)))
    ((ok a)
     (let (s (try (session-new &a (game-mode &a))))
       (try (session-init-new s &a SK-MEDIUM 1 1))
       (let (saved (try (session-save s (strview-from-cstr "e1m1"))) v (view &saved)
             short (slice-of (v 'data) (- (count &saved) 100)))
         (match (session-load s &a short)
           ((ok) (try (check false "a cut-off save loads")))
           ((err e) 0))
         (drop &saved))))))

; Each struct's reader reads what its writer wrote. ~'count: ISSUE-010.
(defmacro sizes-match (v)
  `(let (sv (Saver (~'make (Vector ui8)) (~'make (HashMap usize i32)) (~'make (Vector &Mobj))
                   (~'make (HashMap usize i32)) (~'make (Vector &Thinker)) false)
         x ~v)
     (save-put &sv &x)
     (let (ld (Loader (~'view (ref sv 'out)) 0 none (~'make (Vector &Mobj)) (~'make (Vector &Thinker))))
       (try (save-get &ld &x))
       (try (check (= (ld 'pos) (~'count (ref sv 'out))) "sizes match")))))

(deftest struct-sizes-match
  (sizes-match (VlDoor none 0 0 0 0 0 0 0))
  (sizes-match (FloorMove none 0 0 0 0 0 0 0 0))
  (sizes-match (Ceiling none 0 0 0 0 0 false 0 0 0))
  (sizes-match (Plat none 0 0 0 0 0 0 0 0 false 0 0))
  (sizes-match (LightFlash none 0 0 0 0 0 0))
  (sizes-match (Strobe none 0 0 0 0 0 0))
  (sizes-match (Glow none 0 0 0 0))
  (sizes-match (FireFlicker none 0 0 0 0)))
