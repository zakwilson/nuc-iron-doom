(ns tests.render)

; Regression hashes for the Chocolate Doom renderer port, recorded from frames
; checked by eye. They are not the reference engine's frames (those need
; scripts/build-reference.sh).

(import-use nucleus.test)
(import-use nucleus.strview)
(import-use nucleus.coll)
(import-use doom.error)
(import-use doom.util)
(import-use doom.bytes)
(import-use doom.buffer)
(import-use doom.graphics)
(import-use doom.assets)
(import-use doom.mapdata)
(import-use doom.fixed)
(import-use doom.rand)
(import-use doom.play.map)
(import-use doom.play.world)
(import-use doom.play.defs)
(import-use doom.play.mobj)
(import-use doom.render.state)
(import-use doom.render.view)

(defn- fnv (b:&Buffer):i64
  (let (h:ui32 2166136261)
    (dotimes (y:usize (height b))
      (dotimes (x:usize (width b))
        (set! h (* (bit-xor h (as ui32 (b x y))) 16777619))))
    (return (as i64 h))))

; The eye is 41 units above the floor, as a player's is.
(defn- view-hash (r:&Renderer sc:&Scene x:i32 y:i32 a:Angle):(Fallible i64)
  (let (l (sc 'level) fx (int-to-fixed x) fy (int-to-fixed y)
        fl ((sector-at l ((sub-sector-at l (point-in-sub-sector l fx fy)) 'sector)) 'floor-height)
        e (Eye fx fy (+ fl (int-to-fixed 41)) a 0 -1))
    (try (render-player-view r sc &e))
    (return (ok (fnv (sc 'screen))))))

(deftest e1m1-views
  (match (assets-load (strview-from-cstr "/usr/share/games/doom/doom1.wad"))
    ((err e) (skip! "no shareware IWAD: " (failure-text &e)))
    ((ok a)
     (match (find-map &a 1 1)
       ((none) (try (check false "E1M1 found")))
       ((some m)
        (let (l (try (level-load &m (ref a 'flats) (ref a 'textures)))
              in-game (single-player-in-game)
              w (world-new l (single-player-rules SK-MEDIUM SHAREWARE 1 1) (new-game-players)
                           &in-game (random-new))
              screen (array2d (as usize 320) (as usize 200) (as ui8 0))
              r (renderer-new 11)
              sc (Scene (ref w 'level) (ref a 'textures) (ref a 'flats) (ref a 'colormaps)
                        (ref a 'sprites) (ref w 'sector-things) &screen))
          (try (load-things w &m))
          ; Things spawned on skill 3; the P_Random index after spawning.
          (try (check-eq-int (as i64 (w 'total-kills)) 6 "kills"))
          (try (check-eq-int (as i64 (w 'total-items)) 37 "items"))
          (try (check-eq-int (as i64 ((ref w 'random) 'prnd)) 143 "prndindex"))
          (set! (r 'sky-texture) (unwrap-or (texture-index (ref a 'textures) (name "SKY1")) 0))
          ; The start, facing north and north-west; the courtyard, with sky.
          (try (check-eq-int (try (view-hash &r &sc 1056 -3616 ANG90)) 1971587042 "start view"))
          (try (check-eq-int (try (view-hash &r &sc 1056 -3616 (+ ANG90 ANG45))) 3259163243 "start, turned"))
          (try (check-eq-int (try (view-hash &r &sc 1934 -3215 ANG270)) 635314135 "courtyard"))
          ; A lamp and a corpse, beside the sky.
          (try (check-eq-int (try (view-hash &r &sc 2900 -3000 ANG180)) 3896179092 "lamp"))))))))
