(ns tests.graphics)

(import-use nucleus.test)
(import-use nucleus.strview)
(import-use nucleus.vector)
(import-use nucleus.slice)
(import-use nucleus.coll)
(import-use nucleus.fnv)
(import-use doom.error)
(import-use doom.bytes)
(import-use doom.wad)
(import-use doom.buffer)
(import-use doom.graphics)

(defn- shareware ():(Fallible Wad)
  (return (wad-open (strview-from-cstr "/usr/share/games/doom/doom1.wad"))))

(defn- pixels-hash (b:&Buffer):i64
  (let (c (cells b))
    (return (unsafe/cast i64 (fnv1a-bytes (unsafe/cast &ui8 (c 'data)) (count &c))))))

; Expected hashes: reference/tools/wadref.py, an independent reading of Iron Doom's composer.
(defmacro- check-texture (tx tname w h hash)
  `(if-some (i (texture-index ~tx (name ~tname)))
     (let (t (texture-at ~tx i) px (ref t 'pixels))
       (try (check-eq-int (as i64 (width px)) ~w "texture width"))
       (try (check-eq-int (as i64 (height px)) ~h "texture height"))
       (try (check-eq-int (pixels-hash px) ~hash ~tname)))
     (try (check false ~tname))))

(deftest shareware-graphics
  (match (shareware)
    ((err e) (skip! "no shareware IWAD: " (failure-text &e)))
    ((ok w)
     (let (pals (unwrap (palettes-parse &w)))
       (try (check-eq-int (as i64 (count &pals)) 14 "palettes"))
       (let (p1 (&pals 0))
         (try (check-eq-int (as i64 (palette-r &p1 1)) 0x1f "palette 0 colour 1 red"))))
     (let (fl (unwrap (flats-parse &w)))
       (try (check-eq-int (as i64 (count (ref fl 'list))) 54 "flats"))
       (try (check (= ((flat-at &fl 0) 'name) (name "FLOOR0_1")) "first flat")))
     (let (title (unwrap (patch-parse (ref (unwrap (lump-named &w "TITLEPIC")) 'data))))
       (try (check-eq-int (as i64 (title 'width)) 320 "TITLEPIC width")))
     (let (tx (unwrap (textures-parse &w)))
       (try (check-eq-int (as i64 (count (ref tx 'list))) 125 "textures"))
       (try (check-eq-int (as i64 (unwrap-or (texture-index &tx (name "-")) 99)) 0 "no-texture marker"))
       (check-texture &tx "STARTAN3" 128 128 0x9c016617c70c6095)
       (check-texture &tx "BIGDOOR2" 128 128 0x37782eca22d8ec43)
       (check-texture &tx "SKY1" 256 128 0x602f219a345c2b1b)
       (check-texture &tx "DOOR3" 64 72 0x6a8bd2595050cbc3)))))
