;
; The only place that prints a failure and exits: everything below returns
; a Fallible, as Iron Doom's systems return anyhow::Result to #[sys_fail].

(import-use nucleus.io)
(import-use nucleus.strview)
(import-use nucleus.string)
(import-use nucleus.vector)
(import-use nucleus.coll)
(import-use doom.error)
(import-use doom.cli)
(import-use doom.iwad)
(import-use doom.assets)
(import-use doom.video)
(import-use doom.game)

(defn run (argc:i32 argv:ptr):(Fallible void)
  (let (cl (try (command-line argc argv))
        path (try (locate-iwad (cl 'iwad)))
        assets (try (assets-load (string-as-view &path)))
        g (game-new cl assets (try (video-open))))
    (let (r (game-run &g))
      (video-close (ref g 'video))
      (return r))))

(defn main (argc:i32 argv:ptr):int
  (match (run argc argv)
    ((ok) 0)
    ((err e) (eprintln (failure-text &e)) 1)))
