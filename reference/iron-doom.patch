diff --git a/crates/window/src/framedump.rs b/crates/window/src/framedump.rs
new file mode 100644
index 0000000..c157bba
--- /dev/null
+++ b/crates/window/src/framedump.rs
@@ -0,0 +1,67 @@
+//! Reference harness (nuc-iron-doom): `--framedump <tic,tic,...> <dir>` writes the
+//! screen buffer as a PPM after each listed FixedUpdate tic, then exits.
+
+use crate::palette::GAMMA_TABLE;
+use crate::ScreenBuffer;
+use bevy::prelude::*;
+use cli::CommandLine;
+use std::io::Write;
+use wad::prelude::*;
+
+pub struct FramedumpPlugin;
+
+impl Plugin for FramedumpPlugin {
+    fn build(&self, app: &mut App) {
+        app.init_resource::<TicCount>()
+            .add_systems(FixedFirst, count_tic)
+            .add_systems(Last, dump_frame);
+    }
+}
+
+#[derive(Resource, Default)]
+struct TicCount {
+    tics: u32,
+    dumped: u32,
+}
+
+fn count_tic(mut count: ResMut<TicCount>) {
+    count.tics += 1;
+}
+
+fn dump_frame(
+    mut count: ResMut<TicCount>,
+    cli: Res<CommandLine>,
+    screen: Res<ScreenBuffer>,
+    wad: Option<Res<WadFile>>,
+    mut exit: EventWriter<AppExit>,
+) {
+    if cli.framedump.len() != 2 || count.dumped == count.tics {
+        return;
+    }
+    count.dumped = count.tics;
+    let tics: Vec<u32> = cli.framedump[0]
+        .split(',')
+        .filter_map(|t| t.parse().ok())
+        .collect();
+    if !tics.contains(&count.tics) {
+        return;
+    }
+    let Some(wad) = wad else { return };
+    let palette = wad.get_palette(PaletteVariant::Palette0);
+    let gamma = &GAMMA_TABLE[0];
+    let mut out = Vec::with_capacity(320 * 200 * 3 + 16);
+    write!(out, "P6\n320 200\n255\n").unwrap();
+    for y in 0..200 {
+        for x in 0..320 {
+            let c = &palette[screen[(x, y)] as usize];
+            out.push(gamma[c.r as usize] & !3);
+            out.push(gamma[c.g as usize] & !3);
+            out.push(gamma[c.b as usize] & !3);
+        }
+    }
+    let path = format!("{}/tic{:05}.ppm", cli.framedump[1], count.tics);
+    std::fs::write(&path, out).unwrap();
+    if Some(&count.tics) == tics.iter().max() {
+        exit.send(AppExit::Success);
+    }
+}
