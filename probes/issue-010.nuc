; ISSUE-010: a macro template can't call `count` in a file that imports both
; nucleus.vector and nucleus.slice.
; fixed-when: compiles
; Actual: "macro 'total' names 'count', whose methods here come from namespaces
; 'nucleus.vector', 'nucleus.node', …, 'nucleus.vector', 'nucleus.slice', … and a
; full name reaches one" -- the list repeats namespaces, and the fix (write
; nucleus.slice/count in the template) is left for the reader to infer.

(import-use nucleus.vector)
(import-use nucleus.slice)
(import-use nucleus.create)
(import-use nucleus.coll)

(defmacro total (s) `(count ~s))

(defn main ():i32
  (let (v (make (Vector i32)))
    (conj &v 1)
    (return (- (as i32 (total &v)) 1))))
