From 40cf7d8a8b68b0b9e5da6d54f3d85c424b2ea476 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Thu, 5 Nov 2026 04:56:17 +0000
Subject: [PATCH] Re-arm a let's or with's entry want for its body tail
 (nuc-iron-doom ISSUE-027)

emit-let and emit-with read g-want-type after emitting the bindings and
re-armed that for the body tail. An untyped binding's init inherits the
surrounding want, and a call to a name with methods in more than one loaded
namespace consumes it, so the tail lost its target type: a (some (S ...))
tail built a pointer Maybe and the enclosing match no longer joined. Both
now capture the want on entry.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01CsC8hzrZakM3KWb32SpqKh
---
 src/nucleusc.nuc | 9 +++++++--
 1 file changed, 7 insertions(+), 2 deletions(-)

diff --git a/src/nucleusc.nuc b/src/nucleusc.nuc
index 7ee473a..89483ba 100644
--- a/src/nucleusc.nuc
+++ b/src/nucleusc.nuc
@@ -11716,6 +11716,9 @@
       (when (!= (% (node-len binds) 2) 0)
         (die-at (binds 'line) "let: binding list must be even"))
       (let (inner:&Scope (scope-new scope)
+            ; The want on entry, for the body tail: an untyped binding's init
+            ; inherits it and may consume it (nuc-iron-doom ISSUE-027).
+            entry-want:ptr g-want-type
             i:i32 0)
         (while (< i (node-len binds))
           (let (bname:ptr (node-at binds i)
@@ -11797,7 +11800,7 @@
         (let (last:&Val (alloc-val ty-void "")
               ; TC-5 part 2: re-arm the outer want for the body tail (a binding
               ; init or prior body form may have consumed it).
-              my-want:ptr g-want-type
+              my-want:ptr entry-want
               j:i32 2)
           (while (< j (node-len cc))
             (let (cur:ptr (node-at cc j))
@@ -11826,6 +11829,8 @@
       (when (!= (% (node-len binds) 2) 0)
         (die-at (binds 'line) "with: binding list must be even"))
       (let (inner:&Scope (scope-new scope)
+            ; As emit-let: the want on entry, for the body tail (ISSUE-027).
+            entry-want:ptr g-want-type
             i:i32 0)
         (while (< i (node-len binds))
           (let (bname:ptr (node-at binds i)
@@ -11947,7 +11952,7 @@
         ; of the binding list before the body emits it as an undefined name.
         (check-stray-typed-body (as ptr cc) inner "with")
         (let (last:&Val (alloc-val ty-void "")
-              my-want:ptr g-want-type
+              my-want:ptr entry-want
               j:i32 2)
           (while (< j (node-len cc))
             (let (cur:ptr (node-at cc j))
