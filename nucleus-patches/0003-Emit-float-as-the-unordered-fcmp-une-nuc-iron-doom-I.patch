--- a/tests/suite-doom.nuc
+++ b/tests/suite-doom.nuc
@@ -725,3 +725,15 @@ missing key :sens for #user/Opt"))
         ov:StrView (string-as-view &out))
     (try (check-eq (strview-trim-end &ov) "4 5 0 0"))
     (drop &out)))
+
+; nuc-iron-doom ISSUE-013: float `!=` is unordered, as in C, so NaN != NaN.
+(deftest doom-float-ne-unordered
+  (let (out:String (try (build-run-source "(import-use \"stdio.h\")
+(defn main ():i32
+  (let (z:f32 0.0 n (/ z z) d:f64 0.0 m (/ d d))
+    (printf \"%d %d %d %d %d\\n\" (!= n n) (= n n) (!= m m) (!= z z) (!= z 1.0)))
+  0)
+"))
+        ov:StrView (string-as-view &out))
+    (try (check-eq (strview-trim-end &ov) "1 0 1 0 1"))
+    (drop &out)))
