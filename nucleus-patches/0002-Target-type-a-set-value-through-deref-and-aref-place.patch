+; nuc-iron-doom ISSUE-009: a deref or aref place target-types (some v) and none.
+(deftest doom-place-target-types-maybe
+  (let (out:String (try (build-run-source "(import-use \"stdio.h\")
+(defn main ():i32
+  (let (m:?i32 none p:&?i32 &m a:&?i32 (alloca ?i32 2))
+    (set! @p (some 4))
+    (set! (aref a 0) none)
+    (set! (aref a 1) (some 5))
+    (printf \"%d %d\" (unwrap-or m 0) (unwrap-or (aref a 1) 0))
+    (set! @p none)
+    (set! (aref a 1) none)
+    (printf \" %d %d\\n\" (unwrap-or m 0) (unwrap-or (aref a 1) 0)))
+  0)
+"))
+        ov:StrView (string-as-view &out))
+    (try (check-eq (strview-trim-end &ov) "4 5 0 0"))
+    (drop &out)))
