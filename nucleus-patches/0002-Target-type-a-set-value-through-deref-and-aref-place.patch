+; The value stored by `set!` into a place of type `ty`, emitted as the field and
+; binding places emit theirs: the want channel armed with `ty`, and a bare
+; `(some v)`/`none`/`(ok v)`/`(err e)` built against it (nuc-iron-doom ISSUE-009).
+(defn emit-place-value (call:&Node i:i32 ty:?&Type scope:&Scope):&Val
+  (let (save-want:ptr g-want-type)
+    (set! g-want-type ty)
+    (let (vv:&Val (emit-node-as call i (union-target-rewrite (node-at call i) ty) scope))
+      (set! g-want-type save-want)
+      (return vv))))
+
 (defn emit-ptr-set (call:&Node scope:&Scope):&Val
   (let (cc:&Node call)
     (when (!= (node-len cc) 3) (die-at (cc 'line) "set!: (deref p) place expects a value"))
@@ -8332,7 +8342,7 @@
         (die-at (cc 'line) "set!: (deref p) place: operand must be typed pointer"))
       (require-derefable (p 'type) (cc 'line) "set!")
       (let (elem:?&Type ((p 'type) 'elem)
-            v:&Val (maybe-box-into-slot (emit-node-at cc 2 scope) elem scope (cc 'line))
+            v:&Val (maybe-box-into-slot (emit-place-value cc 2 elem scope) elem scope (cc 'line))
             coerced:ptr (coerce-int-val v elem (cc 'line)))
         (when (= coerced null)
           (die-at (cc 'line) "set!: (deref p) place: value type mismatch"))
